#!/usr/bin/env python3
"""hypora-weather: look up a place, and fetch its forecast.

    hypora-weather search "porto"            places matching a name, as JSON
    hypora-weather fetch <lat> <lon> [c|f]   current conditions and a 3-day forecast

Both use Open-Meteo, which needs no account and no API key.

On privacy: nothing here looks up your location from your IP address. A search sends only
the text you typed; a fetch sends only the coordinates you already chose. Until you pick a
place in the weather panel, Hypora makes no weather requests at all.
"""
import json
import sys
import urllib.parse
import urllib.request

GEOCODE = "https://geocoding-api.open-meteo.com/v1/search"
FORECAST = "https://api.open-meteo.com/v1/forecast"
TIMEOUT = 12

# WMO weather codes -> a short label and which icon to draw
WMO = {
    0:  ("Clear", "clear"),
    1:  ("Mainly clear", "clear"),
    2:  ("Partly cloudy", "partly"),
    3:  ("Overcast", "cloud"),
    45: ("Fog", "fog"),
    48: ("Freezing fog", "fog"),
    51: ("Light drizzle", "drizzle"),
    53: ("Drizzle", "drizzle"),
    55: ("Heavy drizzle", "drizzle"),
    56: ("Freezing drizzle", "drizzle"),
    57: ("Freezing drizzle", "drizzle"),
    61: ("Light rain", "rain"),
    63: ("Rain", "rain"),
    65: ("Heavy rain", "rain"),
    66: ("Freezing rain", "rain"),
    67: ("Freezing rain", "rain"),
    71: ("Light snow", "snow"),
    73: ("Snow", "snow"),
    75: ("Heavy snow", "snow"),
    77: ("Snow grains", "snow"),
    80: ("Light showers", "rain"),
    81: ("Showers", "rain"),
    82: ("Heavy showers", "rain"),
    85: ("Snow showers", "snow"),
    86: ("Snow showers", "snow"),
    95: ("Thunderstorm", "storm"),
    96: ("Thunderstorm, hail", "storm"),
    99: ("Thunderstorm, hail", "storm"),
}


def get(url, params):
    full = f"{url}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(full, headers={"User-Agent": "hypora-weather"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return json.load(r)


def describe(code):
    return WMO.get(code, ("Unknown", "cloud"))


def search(query):
    if not query.strip():
        return {"results": []}
    data = get(GEOCODE, {"name": query, "count": 8, "language": "en", "format": "json"})
    out = []
    for r in data.get("results", []):
        where = ", ".join(p for p in (r.get("admin1"), r.get("country")) if p)
        out.append({
            "name": r["name"],
            "detail": where,
            "latitude": round(r["latitude"], 4),
            "longitude": round(r["longitude"], 4),
        })
    return {"results": out}


def fetch(lat, lon, unit):
    fahrenheit = unit.lower().startswith("f")
    params = {
        "latitude": lat,
        "longitude": lon,
        "current": "temperature_2m,apparent_temperature,relative_humidity_2m,is_day,weather_code,wind_speed_10m",
        "daily": "weather_code,temperature_2m_max,temperature_2m_min",
        "timezone": "auto",
        "forecast_days": 4,
    }
    if fahrenheit:
        params["temperature_unit"] = "fahrenheit"
        params["wind_speed_unit"] = "mph"
    d = get(FORECAST, params)

    cur = d.get("current", {})
    label, icon = describe(cur.get("weather_code"))
    daily = d.get("daily", {})
    days = []
    for i, date in enumerate(daily.get("time", [])):
        dl, di = describe(daily["weather_code"][i])
        days.append({
            "date": date,
            "label": dl,
            "icon": di,
            "max": round(daily["temperature_2m_max"][i]),
            "min": round(daily["temperature_2m_min"][i]),
        })
    return {
        "unit": "F" if fahrenheit else "C",
        "windUnit": "mph" if fahrenheit else "km/h",
        "current": {
            "temp": round(cur.get("temperature_2m", 0)),
            "feelsLike": round(cur.get("apparent_temperature", 0)),
            "humidity": cur.get("relative_humidity_2m"),
            "wind": round(cur.get("wind_speed_10m", 0)),
            "isDay": bool(cur.get("is_day", 1)),
            "label": label,
            "icon": icon,
        },
        "days": days,
        "timezone": d.get("timezone", ""),
    }


def main(argv):
    try:
        if len(argv) >= 3 and argv[1] == "search":
            print(json.dumps(search(" ".join(argv[2:]))))
        elif len(argv) >= 4 and argv[1] == "fetch":
            print(json.dumps(fetch(argv[2], argv[3], argv[4] if len(argv) > 4 else "c")))
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except Exception as e:                       # network down, bad coords, rate limit
        print(json.dumps({"error": str(e)}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
