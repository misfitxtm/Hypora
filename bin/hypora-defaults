#!/usr/bin/env python3
"""hypora-defaults: which app opens which kind of file.

    hypora-defaults list             common file types and anything you've set, as JSON
    hypora-defaults lookup <ext>     one extension, as JSON (e.g. qml or .qml)
    hypora-defaults set <ext> <app>  open .<ext> files with <app>, a desktop id (nvim.desktop)
    hypora-defaults reset <ext>      forget your choice; the system's default applies again

Backs the Default Apps window (Menu > Settings > Default Apps). It only ever writes your own
~/.config/mimeapps.list, the freedesktop file every toolkit reads, so it needs no root and a
choice made here is the same one Files, Firefox and `xdg-open` see.

Defaults belong to MIME types, not extensions. .qml, .qmltypes and .qmlproject are all
text/x-qml, so choosing an app for one chooses it for all three — the JSON says so in
`alsoCovers`, and the window shows it, rather than letting it come as a surprise.

An extension no MIME type claims gets a small one of its own (application/x-hypora-<ext>)
in ~/.local/share/mime, because there is no way to name a default for an extension alone.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
DATA_DIRS = [DATA_HOME] + [Path(d) for d in
             (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
USER_MIMEAPPS = CONFIG_HOME / "mimeapps.list"
USER_MIME = DATA_HOME / "mime"

# What the window lists before you add anything: the types people actually change.
COMMON = ["txt", "md", "pdf", "html", "json", "py", "sh",
          "png", "jpg", "gif", "webp", "svg",
          "mp3", "flac", "ogg", "mp4", "mkv", "webm",
          "zip", "tar.gz", "7z", "iso"]

# Validated because they become a file name, an XML attribute and a mimeapps.list key
EXT_RE = re.compile(r"\A[a-z0-9][a-z0-9_+.-]{0,15}\Z")
APP_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]*\.desktop\Z")
# Exec field codes meaning "give me the file": an app without one cannot open anything
FILE_CODES = re.compile(r"%[fFuU]")


def ext_of(raw):
    ext = raw.strip().lower().lstrip(".")
    if not EXT_RE.match(ext):
        sys.exit(f"Not a plain file extension: {raw!r} (letters, digits, and . _ + -)")
    return ext


# ---------- MIME types ----------

def load_globs():
    """ext -> mime, and mime -> [ext], from every globs2 on the data path.

    Only simple `*.ext` globs: the rest (Makefile, README*) are not extensions. The highest
    weight wins, and on a tie the earlier directory — yours, before the system's.
    """
    best, exts = {}, {}
    for d in DATA_DIRS:
        try:
            lines = (d / "mime/globs2").read_text(errors="replace").splitlines()
        except OSError:
            continue
        for line in lines:
            if line.startswith("#"):
                continue
            parts = line.split(":")
            if len(parts) < 3 or not parts[2].startswith("*."):
                continue
            ext = parts[2][2:].lower()
            if not EXT_RE.match(ext):
                continue
            try:
                weight = int(parts[0])
            except ValueError:
                continue
            mime = parts[1]
            exts.setdefault(mime, [])
            if ext not in exts[mime]:
                exts[mime].append(ext)
            if ext not in best or weight > best[ext][0]:
                best[ext] = (weight, mime)
    return {e: m for e, (_, m) in best.items()}, exts


def describe(mime):
    """The type's English description, e.g. "PDF document"."""
    for d in DATA_DIRS:
        try:
            m = re.search(r"<comment>([^<]*)</comment>", (d / "mime" / f"{mime}.xml").read_text())
        except OSError:
            continue
        if m:
            return m.group(1)
    return mime


def add_mime_type(ext):
    """Give an extension nothing claims a MIME type of its own, in ~/.local/share/mime."""
    mime = f"application/x-hypora-{ext.replace('.', '-')}"
    pkg = USER_MIME / "packages" / f"hypora-{ext}.xml"
    pkg.parent.mkdir(parents=True, exist_ok=True)
    pkg.write_text(
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<!-- Added by hypora-defaults so .{0} files can have a default app. -->\n'
        '<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">\n'
        '  <mime-type type="{1}">\n'
        '    <comment>.{0} file</comment>\n'
        '    <glob pattern="*.{0}"/>\n'
        '  </mime-type>\n'
        '</mime-info>\n'.format(ext, mime))
    rc = subprocess.run(["update-mime-database", str(USER_MIME)], capture_output=True).returncode
    if rc != 0:
        pkg.unlink(missing_ok=True)
        sys.exit("update-mime-database failed, so the new file type was not registered.")
    return mime


# ---------- applications ----------

def entry_fields(path):
    """Keys of the [Desktop Entry] group only — actions have their own Name= lines."""
    out, inside = {}, False
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return None
    for line in lines:
        if line.startswith("["):
            inside = line.strip() == "[Desktop Entry]"
            continue
        if inside and "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            out.setdefault(k.strip(), v.strip())
    return out


def load_apps():
    """desktop id -> {id, name, mimes, shown}, for every app that can open a file.

    Searched in data-path order and the first copy of an id wins, which is how a file in
    ~/.local/share/applications overrides the system's. `shown` is false for NoDisplay
    entries: those are offered only for types they declare, never in the full list.
    """
    apps = {}
    for d in DATA_DIRS:
        root = d / "applications"
        if not root.is_dir():
            continue
        for path in sorted(root.rglob("*.desktop")):
            app_id = str(path.relative_to(root)).replace("/", "-")
            if app_id in apps:
                continue
            f = entry_fields(path)
            apps[app_id] = None   # claimed, even if unusable, so a lower copy can't win
            if not f or f.get("Type") != "Application" or f.get("Hidden") == "true":
                continue
            if not FILE_CODES.search(f.get("Exec", "")):
                continue
            try_exec = f.get("TryExec")
            if try_exec and not (os.path.isabs(try_exec) and os.access(try_exec, os.X_OK)) \
                    and not any(os.access(os.path.join(p, try_exec), os.X_OK)
                                for p in os.environ.get("PATH", "").split(":")):
                continue
            apps[app_id] = {
                "id": app_id,
                "name": f.get("Name", app_id),
                "mimes": [m for m in f.get("MimeType", "").split(";") if m],
                "shown": f.get("NoDisplay") != "true",
            }
    return {k: v for k, v in apps.items() if v}


# ---------- defaults ----------

def read_section(path, section):
    """{mime: [desktop ids]} from one group of a mimeapps.list."""
    out, inside = {}, False
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return out
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            inside = s == f"[{section}]"
        elif inside and "=" in s and not s.startswith("#"):
            k, v = s.split("=", 1)
            out.setdefault(k.strip(), [i for i in v.split(";") if i])
    return out


def current_default(mime, apps):
    """(desktop id, chosen-by-you) for a type, or (None, False).

    Asked of GIO rather than worked out here, because GIO is what Files and most apps use
    to open a file, and its fallback when nothing is set — a ranking over every installed
    app's associations — is not something worth re-implementing just to disagree with it.
    The window has to show what will actually happen.
    """
    p = subprocess.run(["gio", "mime", mime], capture_output=True, text=True,
                       env={**os.environ, "LC_ALL": "C"})
    first = p.stdout.splitlines()[0] if p.returncode == 0 and p.stdout else ""
    m = re.match(r"Default application for .*: (\S+\.desktop)$", first)
    if not m or m.group(1) not in apps:
        return None, False
    app_id = m.group(1)
    mine = read_section(USER_MIMEAPPS, "Default Applications").get(mime, [])
    return app_id, bool(mine) and mine[0] == app_id


def row(ext, mime, mime_exts, apps):
    if mime is None:
        return {"ext": ext, "mime": None, "description": f".{ext} file",
                "alsoCovers": [], "current": None, "currentName": "", "chosen": False,
                "candidates": []}
    cur, chosen = current_default(mime, apps)
    candidates = sorted((a for a in apps.values() if mime in a["mimes"]),
                        key=lambda a: a["name"].lower())
    return {
        "ext": ext,
        "mime": mime,
        "description": describe(mime),
        "alsoCovers": [e for e in mime_exts.get(mime, []) if e != ext],
        "current": cur,
        "currentName": apps[cur]["name"] if cur else "",
        "chosen": chosen,
        "candidates": [{"id": a["id"], "name": a["name"]} for a in candidates],
    }


def all_apps(apps):
    return [{"id": a["id"], "name": a["name"]}
            for a in sorted(apps.values(), key=lambda a: a["name"].lower()) if a["shown"]]


# ---------- commands ----------

def cmd_list():
    ext_mime, mime_exts = load_globs()
    apps = load_apps()
    exts = list(COMMON)
    # Plus every type you have chosen an app for, under its first extension
    for mime in read_section(USER_MIMEAPPS, "Default Applications"):
        known = mime_exts.get(mime)
        if known and not any(ext_mime.get(e) == mime for e in exts):
            exts.append(known[0])
    rows = [row(e, ext_mime.get(e), mime_exts, apps) for e in exts]
    rows = [r for r in rows if r["mime"]]
    print(json.dumps({"rows": rows, "apps": all_apps(apps)}))
    return 0


def cmd_lookup(raw):
    ext = ext_of(raw)
    ext_mime, mime_exts = load_globs()
    print(json.dumps(row(ext, ext_mime.get(ext), mime_exts, load_apps())))
    return 0


def cmd_set(raw, app_id):
    ext = ext_of(raw)
    if not APP_RE.match(app_id):
        sys.exit(f"Not a desktop id: {app_id!r}")
    apps = load_apps()
    if app_id not in apps:
        sys.exit(f"{app_id} is not installed, or cannot open files.")
    ext_mime, _ = load_globs()
    mime = ext_mime.get(ext) or add_mime_type(ext)
    # gio rather than editing the file here: it records the app under Added Associations
    # as well as Default Applications, which GIO needs before it will honour a default for
    # an app that doesn't itself declare the type — Neovim and .qml, for one.
    p = subprocess.run(["gio", "mime", mime, app_id], capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(f"Could not set the default: {(p.stderr or p.stdout).strip()[:200]}")
    print(f".{ext} ({mime}) now opens with {apps[app_id]['name']}.")
    return 0


def cmd_reset(raw):
    """Drop your Default Applications line for the type. Added Associations stay, so the
    app is still offered under Open With — forgetting a default is not uninstalling."""
    ext = ext_of(raw)
    ext_mime, _ = load_globs()
    mime = ext_mime.get(ext)
    if not mime or not USER_MIMEAPPS.is_file():
        print(f"Nothing set for .{ext}.")
        return 0
    lines, inside, changed = USER_MIMEAPPS.read_text().splitlines(), False, False
    kept = []
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            inside = s == "[Default Applications]"
        elif inside and s.split("=", 1)[0].strip() == mime:
            changed = True
            continue
        kept.append(line)
    if changed:
        tmp = USER_MIMEAPPS.with_name(".mimeapps.list.hypora-tmp")
        tmp.write_text("\n".join(kept) + "\n")
        os.replace(tmp, USER_MIMEAPPS)
    print(f".{ext} is back on the system default." if changed else f"Nothing set for .{ext}.")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "list"
    if cmd == "list":
        return cmd_list()
    if cmd == "lookup" and len(argv) == 3:
        return cmd_lookup(argv[2])
    if cmd == "set" and len(argv) == 4:
        return cmd_set(argv[2], argv[3])
    if cmd == "reset" and len(argv) == 3:
        return cmd_reset(argv[2])
    print(__doc__, file=sys.stderr)
    return 0 if cmd in ("-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
