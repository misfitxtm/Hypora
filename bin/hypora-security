#!/usr/bin/env python3
"""hypora-security: report and change the system's security settings.

    hypora-security status                      print everything as JSON (no root needed)
    hypora-security selinux <enforcing|permissive>   change the running mode
    hypora-security selinux-boot <enforcing|permissive|disabled>   change it for next boot
    hypora-security camera <on|off>             load or unload the webcam driver
    hypora-security location <on|off>           unmask or mask geoclue

Only `status` runs unprivileged; the rest need root and are meant to be run with pkexec,
which puts the request through Hypora's polkit prompt. Run `status` yourself to see exactly
what the Security window is reading.
"""
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

SB_GUID = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
EFIVARS = Path("/sys/firmware/efi/efivars")
SELINUX_CONFIG = Path("/etc/selinux/config")


def run(cmd, timeout=10):
    """(returncode, stdout) — never raises."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def efivar_bool(name):
    """Last byte of an efivar, past the 4-byte attribute header."""
    try:
        data = (EFIVARS / f"{name}-{SB_GUID}").read_bytes()
    except OSError:
        return None
    return bool(data[4]) if len(data) >= 5 else None


# ---------- status ----------

def secure_boot():
    if not Path("/sys/firmware/efi").is_dir():
        return {"firmware": "bios", "supported": False, "enabled": False,
                "note": "This machine booted in legacy BIOS mode, where Secure Boot does not apply."}
    out = {"firmware": "uefi", "supported": True}
    # mokutil is the authoritative answer; the efivar is the fallback
    if shutil.which("mokutil"):
        rc, text = run(["mokutil", "--sb-state"])
        if rc == 0 and text:
            out["enabled"] = "enabled" in text.lower()
            out["source"] = "mokutil"
            return out
    val = efivar_bool("SecureBoot")
    if val is None:
        out["supported"] = False
        out["enabled"] = False
        out["note"] = "No SecureBoot EFI variable; the firmware does not report a state."
    else:
        out["enabled"] = val
        out["setupMode"] = efivar_bool("SetupMode")
        out["source"] = "efivars"
    return out


def firmware_checks():
    """fwupd's Host Security ID — the same checks GNOME's Device Security shows."""
    if not shutil.which("fwupdmgr"):
        return {"available": False, "note": "fwupd is not installed, so firmware checks can't be read."}
    rc, text = run(["fwupdmgr", "security", "--json"], timeout=30)
    if not text:
        return {"available": False, "note": "fwupd did not respond."}
    try:
        data = json.loads(text)
    except ValueError:
        return {"available": False, "note": "fwupd returned something unreadable."}
    if "Error" in data:
        return {"available": False, "note": data["Error"].get("Message", "fwupd reported an error.")}

    attrs, passed, failed = data.get("SecurityAttributes", []), 0, []
    for a in attrs:
        flags = a.get("Flags", [])
        if "success" in flags:
            passed += 1
        else:
            name = a.get("Name") or a.get("AppstreamId", "").replace("org.fwupd.hsi.", "")
            failed.append({"name": name, "result": a.get("HsiResult", "")})
    return {
        "available": True,
        "hsi": data.get("HostSecurityId", ""),
        "passed": passed,
        "total": len(attrs),
        "failed": failed[:8],
    }


def encryption():
    """Is / on an encrypted volume, and does any swap reach the disk unencrypted?

    Walks lsblk's tree rather than asking about a device directly: a device only counts as
    encrypted if a LUKS/crypt layer sits somewhere above it. zram swap lives in RAM, so it
    never reaches the disk and isn't a leak.
    """
    rc, out = run(["lsblk", "-J", "-o", "NAME,TYPE,FSTYPE,MOUNTPOINTS"])
    if rc != 0 or not out:
        rc, out = run(["lsblk", "-J", "-o", "NAME,TYPE,FSTYPE,MOUNTPOINT"])
    if rc != 0 or not out:
        return {"available": False, "note": "lsblk did not report the disk layout."}
    try:
        tree = json.loads(out)["blockdevices"]
    except (ValueError, KeyError):
        return {"available": False, "note": "Could not read the disk layout."}

    root = None
    swaps = []

    def mounts(node):
        mp = node.get("mountpoints")
        if mp is None:
            mp = [node.get("mountpoint")]
        return [m for m in mp if m]

    def walk(nodes, chain):
        nonlocal root
        for n in nodes:
            here = chain + [n]
            kinds = {x.get("type") for x in here}
            for m in mounts(n):
                if m == "/" and root is None:
                    root = {"device": n["name"], "encrypted": "crypt" in kinds}
                elif m == "[SWAP]":
                    zram = n["name"].startswith("zram")
                    swaps.append({
                        "name": n["name"],
                        "kind": "zram" if zram else (n.get("type") or "device"),
                        # zram is RAM-backed, so nothing is written to the disk
                        "safe": zram or "crypt" in kinds,
                    })
            walk(n.get("children") or [], here)

    walk(tree, [])
    exposed = [s["name"] for s in swaps if not s["safe"]]
    return {
        "available": root is not None,
        "rootEncrypted": bool(root and root["encrypted"]),
        "rootDevice": root["device"] if root else "",
        "swap": swaps,
        "unencryptedSwap": exposed,
    }


def dns():
    """Are lookups going through systemd-resolved, and are they encrypted?

    The DNS-over-TLS mode comes from resolved's own D-Bus property rather than the config
    file, because a config file says what was asked for and the property says what is
    actually in effect (`resolvectl dnsovertls` can change it at runtime, which is how you
    get past a captive portal).
    """
    rc, state = run(["systemctl", "is-active", "systemd-resolved.service"])
    if state != "active":
        return {"available": False,
                "note": "systemd-resolved isn't running, so DNS goes wherever the network says."}

    out = {"available": True, "mode": "unknown", "server": ""}

    rc, text = run(["busctl", "--json=short", "get-property", "org.freedesktop.resolve1",
                    "/org/freedesktop/resolve1", "org.freedesktop.resolve1.Manager",
                    "DNSOverTLS"])
    if rc == 0 and text:
        try:
            out["mode"] = json.loads(text).get("data") or "unknown"
        except ValueError:
            pass

    rc, text = run(["resolvectl", "status", "--no-pager"])
    if rc == 0 and text:
        if out["mode"] == "unknown":
            # Older resolved versions don't expose the property; the status text still says
            if "+DNSOverTLS" in text:
                out["mode"] = "yes"
            elif "-DNSOverTLS" in text:
                out["mode"] = "no"
        m = re.search(r"^\s*Current DNS Server:\s*(\S+)", text, re.M)
        if not m:
            m = re.search(r"^\s*DNS Servers:\s*(\S+)", text, re.M)
        if m:
            out["server"] = m.group(1)
        m = re.search(r"^\s*resolv\.conf mode:\s*(\S+)", text, re.M)
        if m:
            out["resolvConf"] = m.group(1)

    out["encrypted"] = out["mode"] in ("yes", "opportunistic")
    out["strict"] = out["mode"] == "yes"
    return out


def mac_addresses():
    """Is each network card presenting something other than its permanent address?

    Reads the live addresses rather than the policy: NetworkManager's default can be
    overridden per connection, so the only honest answer comes from comparing what the
    card is using now against what is burned into it. A device that isn't connected
    usually shows its permanent address, which is not a leak in itself — nothing is being
    broadcast — so it's reported as such rather than as a failure.
    """
    if not shutil.which("nmcli"):
        return {"available": False, "note": "nmcli is not installed, so MAC addresses can't be read."}

    rc, out = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"])
    if rc != 0:
        return {"available": False, "note": "NetworkManager did not report any devices."}

    devices = []
    for line in out.splitlines():
        parts = line.split(":")
        if len(parts) < 3 or parts[1] not in ("wifi", "ethernet"):
            continue
        name, kind, state = parts[0], parts[1], parts[2]
        rc, info = run(["nmcli", "-t", "--escape", "no", "-f",
                        "GENERAL.HWADDR,GENERAL.PERM-HWADDR", "device", "show", name])
        if rc != 0:
            continue
        addrs = {}
        for row in info.splitlines():
            key, _, value = row.partition(":")
            addrs[key.strip()] = value.strip().replace("\\", "")
        now = addrs.get("GENERAL.HWADDR", "")
        perm = addrs.get("GENERAL.PERM-HWADDR", "")
        devices.append({
            "name": name,
            "kind": kind,
            "connected": state == "connected",
            # Some drivers don't report a permanent address; then there's nothing to compare
            "known": bool(now and perm and perm != "(unknown)"),
            "randomized": bool(now and perm and perm != "(unknown)" and now.lower() != perm.lower()),
        })

    policy = ""
    try:
        text = Path("/etc/NetworkManager/conf.d/hypora-mac.conf").read_text()
        m = re.search(r"^\s*wifi\.cloned-mac-address\s*=\s*(\S+)", text, re.M)
        if m:
            policy = m.group(1)
    except OSError:
        pass

    return {
        "available": bool(devices),
        "note": "" if devices else "No Wi-Fi or ethernet device to report on.",
        "policy": policy,
        "devices": devices,
        # Only count devices that are actually on a network: a parked card tells us nothing
        "activeLeaks": [d["name"] for d in devices
                        if d["connected"] and d["known"] and not d["randomized"]],
    }


def _automatic_conf():
    """dnf5's merged automatic settings: packaged defaults, then the host's overrides."""
    import configparser
    parser = configparser.ConfigParser(interpolation=None)
    for path in ("/usr/share/dnf5/dnf5-plugins/automatic.conf",
                 "/etc/dnf/dnf5-plugins/automatic.conf",
                 "/etc/dnf/automatic.conf"):
        try:
            parser.read_string(Path(path).read_text(), source=path)
        except (OSError, configparser.Error):
            continue
    if not parser.has_section("commands"):
        return {}
    return dict(parser["commands"])


def updates():
    """Are security updates installing on their own — for packages and for flatpaks?

    Two timers, because neither covers the other: dnf never sees flatpaks, and the flatpak
    timer never sees the system.
    """
    out = {"available": True}

    timer = ""
    for candidate in ("dnf5-automatic.timer", "dnf-automatic.timer"):
        rc, state = run(["systemctl", "is-enabled", candidate])
        if state and state != "not-found":
            timer, out["packagesState"] = candidate, state
            break
    conf = _automatic_conf()
    applies = str(conf.get("apply_updates", "no")).strip().lower() in ("yes", "true", "1")
    out["packagesTimer"] = timer
    out["packagesEnabled"] = bool(timer) and out.get("packagesState") == "enabled"
    out["packagesApply"] = applies
    out["upgradeType"] = str(conf.get("upgrade_type", "")).strip()
    if not timer:
        out["packagesNote"] = "dnf's automatic update timer isn't installed."
    elif not out["packagesEnabled"]:
        out["packagesNote"] = "The timer exists but isn't enabled, so nothing updates on its own."
    elif not applies:
        out["packagesNote"] = "Updates are downloaded but not installed (apply_updates is off)."

    if timer:
        _, last = run(["systemctl", "show", "-p", "LastTriggerUSec", "--value", timer])
        out["packagesLastRun"] = last if last and last != "n/a" else ""

    rc, state = run(["systemctl", "is-enabled", "hypora-flatpak-update.timer"])
    out["flatpakState"] = state or "not-found"
    out["flatpakEnabled"] = state == "enabled"
    return out


def firewall():
    """firewalld's state and zone. Fedora's own zone leaves the high ports open."""
    if not shutil.which("firewall-cmd"):
        return {"available": False, "note": "firewalld is not installed."}
    rc, state = run(["firewall-cmd", "--state"])
    if state != "running":
        return {"available": True, "running": False,
                "note": "firewalld is installed but not running, so nothing is filtering."}
    _, zone = run(["firewall-cmd", "--get-default-zone"])
    rc, ports = run(["firewall-cmd", f"--zone={zone}", "--list-ports"])
    return {
        "available": True,
        "running": True,
        "zone": zone,
        "openPorts": ports.split() if rc == 0 and ports else [],
        # FedoraWorkstation permits 1025-65535 on TCP and UDP; public is closed by default
        "permissive": zone == "FedoraWorkstation",
    }


def selinux():
    if not shutil.which("getenforce"):
        return {"available": False, "note": "SELinux tools are not installed."}
    _, mode = run(["getenforce"])
    out = {"available": True, "mode": mode.lower() or "unknown"}
    try:
        text = SELINUX_CONFIG.read_text()
        m = re.search(r"^\s*SELINUX\s*=\s*(\w+)", text, re.M)
        if m:
            out["boot"] = m.group(1).lower()
        m = re.search(r"^\s*SELINUXTYPE\s*=\s*(\w+)", text, re.M)
        if m:
            out["policy"] = m.group(1)
    except OSError:
        pass
    # Going from disabled to enforcing needs a full filesystem relabel on the next boot
    out["needsRelabel"] = out["mode"] == "disabled"
    return out


def camera():
    devices = sorted(str(p) for p in Path("/dev").glob("video*"))
    try:
        mods = Path("/proc/modules").read_text()
    except OSError:
        mods = ""
    driver_loaded = bool(re.search(r"^uvcvideo ", mods, re.M))
    return {
        "devices": devices,
        "present": bool(devices) or driver_loaded,
        "enabled": bool(devices),
        "driver": "uvcvideo" if driver_loaded else "",
    }


def location():
    rc, state = run(["systemctl", "is-enabled", "geoclue.service"])
    if state == "" and rc != 0:
        return {"available": False, "note": "GeoClue is not installed, so nothing requests your location."}
    return {"available": True, "enabled": state != "masked", "state": state}


def file_history():
    out = {}
    if shutil.which("gsettings"):
        rc, v = run(["gsettings", "get", "org.gnome.desktop.privacy", "remember-recent-files"])
        if rc == 0:
            out["remember"] = v.strip() == "true"
        rc, v = run(["gsettings", "get", "org.gnome.desktop.privacy", "recent-files-max-age"])
        if rc == 0:
            try:
                out["maxAge"] = int(v.strip())
            except ValueError:
                pass
    recent = Path.home() / ".local/share/recently-used.xbel"
    out["entries"] = len(re.findall(r"<bookmark ", recent.read_text(errors="replace"))) if recent.is_file() else 0
    out["available"] = "remember" in out
    if not out["available"]:
        out["note"] = "The GNOME privacy settings schema isn't installed."
    return out


def status():
    return {
        "secureBoot": secure_boot(),
        "encryption": encryption(),
        "firmware": firmware_checks(),
        "dns": dns(),
        "mac": mac_addresses(),
        "firewall": firewall(),
        "updates": updates(),
        "selinux": selinux(),
        "camera": camera(),
        "location": location(),
        "fileHistory": file_history(),
    }


# ---------- actions (root) ----------

def need_root():
    if os.geteuid() != 0:
        print("This needs root; run it with pkexec.", file=sys.stderr)
        sys.exit(1)


def set_selinux(mode):
    need_root()
    if mode not in ("enforcing", "permissive"):
        sys.exit("mode must be enforcing or permissive")
    rc, _ = run(["setenforce", "1" if mode == "enforcing" else "0"])
    sys.exit(rc)


def set_selinux_boot(mode):
    need_root()
    if mode not in ("enforcing", "permissive", "disabled"):
        sys.exit("mode must be enforcing, permissive or disabled")
    try:
        text = SELINUX_CONFIG.read_text()
    except OSError as e:
        sys.exit(f"cannot read {SELINUX_CONFIG}: {e}")
    new, n = re.subn(r"^\s*SELINUX\s*=\s*\w+", f"SELINUX={mode}", text, count=1, flags=re.M)
    if n == 0:
        new = text.rstrip("\n") + f"\nSELINUX={mode}\n"
    SELINUX_CONFIG.write_text(new)
    # Ask for a relabel so the next boot can actually enforce
    if mode in ("enforcing", "permissive"):
        Path("/.autorelabel").touch()
    print(f"SELINUX={mode} set for the next boot")


def set_camera(state):
    need_root()
    if state == "off":
        rc, _ = run(["modprobe", "-r", "uvcvideo"])
        if rc != 0:
            sys.exit("Could not unload uvcvideo — something is probably using the camera.")
    elif state == "on":
        rc, _ = run(["modprobe", "uvcvideo"])
        if rc != 0:
            sys.exit("Could not load uvcvideo.")
    else:
        sys.exit("state must be on or off")


def set_location(state):
    need_root()
    if state == "off":
        run(["systemctl", "stop", "geoclue.service"])
        rc, _ = run(["systemctl", "mask", "geoclue.service"])
    elif state == "on":
        rc, _ = run(["systemctl", "unmask", "geoclue.service"])
    else:
        sys.exit("state must be on or off")
    sys.exit(rc)


def main(argv):
    if len(argv) < 2 or argv[1] == "status":
        print(json.dumps(status(), indent=2))
        return 0
    cmd, arg = argv[1], (argv[2] if len(argv) > 2 else "")
    actions = {
        "selinux": set_selinux,
        "selinux-boot": set_selinux_boot,
        "camera": set_camera,
        "location": set_location,
    }
    if cmd not in actions:
        print(__doc__, file=sys.stderr)
        return 2
    actions[cmd](arg)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
