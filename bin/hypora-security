#!/usr/bin/env python3
"""hypora-security: report and change the system's security settings.

    hypora-security status                      print the state as JSON, never asks for a password
    hypora-security deep                        the two readings that need root, as JSON
    hypora-security status --deep               status plus those two, run as the caller
    hypora-security firmware                    only the fwupd firmware checks
    hypora-security selinux <enforcing|permissive>   change the running mode
    hypora-security selinux-boot <enforcing|permissive>   change it for next boot
    hypora-security camera <on|off>             load or unload the webcam driver
    hypora-security location <on|off>           unmask or mask geoclue
    hypora-security add-swapfile [size]         make an encrypted swapfile (default 4g)
    hypora-security remove-swapfile             switch it off and delete it

`status` and `firmware` run without root. The other commands need root and are meant
to be run with pkexec.

Plain `status` never triggers a polkit prompt, so the Security window can open without
asking for a password. Two checks can prompt, so they only run with `--deep`:
`fwupdmgr security` (reads BIOS settings) and firewall-cmd's zone and port queries.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

SB_GUID = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
EFIVARS = Path("/sys/firmware/efi/efivars")
SELINUX_CONFIG = Path("/etc/selinux/config")


def atomic_write(path, text):
    """Replace a file so it is never left half-written.

    Write a temporary file next to it, flush it to disk, then rename it over the
    original (a rename is atomic). After a crash the file is the old or the new version,
    never an empty one. Owner, mode and the SELinux label are kept.
    """
    path = Path(path)
    tmp = path.with_name(f".{path.name}.hypora-tmp")
    st = path.stat() if path.exists() else None
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        if st:
            os.chown(tmp, st.st_uid, st.st_gid)
            os.chmod(tmp, st.st_mode & 0o7777)
        else:
            os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise
    dfd = os.open(path.parent, os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)
    try:
        subprocess.run(["restorecon", str(path)], capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        pass


def run(cmd, timeout=10):
    """Return (exit code, stdout). Never raises."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def efivar_bool(name):
    """Read an EFI variable as a boolean (its last byte, after a 4-byte header)."""
    try:
        data = (EFIVARS / f"{name}-{SB_GUID}").read_bytes()
    except OSError:
        return None
    return bool(data[4]) if len(data) >= 5 else None


# ---------- status ----------

def secure_boot():
    if not Path("/sys/firmware/efi").is_dir():
        return {"firmware": "bios", "supported": False, "enabled": False,
                "note": "This machine booted in legacy BIOS mode, where Secure Boot does not apply."}
    out = {"firmware": "uefi", "supported": True}

    # Setup Mode means Secure Boot is switched on but has no keys, so it checks nothing.
    # That needs a different message from plain "off".
    setup = efivar_bool("SetupMode")
    if setup is not None:
        out["setupMode"] = setup

    # mokutil is the best source; the EFI variable is the fallback
    if shutil.which("mokutil"):
        rc, text = run(["mokutil", "--sb-state"])
        if rc == 0 and text:
            out["enabled"] = "enabled" in text.lower()
            out["source"] = "mokutil"
    if "enabled" not in out:
        val = efivar_bool("SecureBoot")
        if val is None:
            out["supported"] = False
            out["enabled"] = False
            out["note"] = "No SecureBoot EFI variable; the firmware does not report a state."
            return out
        out["enabled"] = val
        out["source"] = "efivars"

    if not out["enabled"] and out.get("setupMode"):
        out["note"] = ("The firmware is in Setup Mode: Secure Boot is switched on but no "
                       "platform key is enrolled, so nothing is being verified. In your "
                       "UEFI setup, look for \"Restore Factory Keys\" or \"Reset to "
                       "Setup Mode\" and make sure the default keys are installed.")
    return out


def firmware_checks():
    """fwupd's Host Security ID checks (the same ones GNOME's Device Security shows)."""
    if not shutil.which("fwupdmgr"):
        return {"available": False, "note": "fwupd is not installed, so firmware checks can't be read."}
    rc, text = run(["fwupdmgr", "security", "--json"], timeout=30)
    if not text:
        return {"available": False, "note": "fwupd did not respond."}
    try:
        data = json.loads(text)
    except ValueError:
        return {"available": False, "note": "fwupd returned something unreadable."}
    if "Error" in data:
        return {"available": False, "note": data["Error"].get("Message", "fwupd reported an error.")}

    attrs, passed, failed = data.get("SecurityAttributes", []), 0, []
    for a in attrs:
        flags = a.get("Flags", [])
        if "success" in flags:
            passed += 1
        else:
            name = a.get("Name") or a.get("AppstreamId", "").replace("org.fwupd.hsi.", "")
            failed.append({"name": name, "result": a.get("HsiResult", "")})
    return {
        "available": True,
        "hsi": data.get("HostSecurityId", ""),
        "passed": passed,
        "total": len(attrs),
        "failed": failed[:8],
    }


def crypttab_random_keyed():
    """Names in /etc/crypttab that get a fresh random key on every boot."""
    names = set()
    try:
        text = Path("/etc/crypttab").read_text()
    except OSError:
        return names
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) >= 3 and parts[2] in ("/dev/urandom", "/dev/random"):
            names.add(parts[0])
    return names


def swap_files():
    """Swap that lives in a file. lsblk only shows devices, so these are read separately."""
    out = []
    try:
        lines = Path("/proc/swaps").read_text().splitlines()[1:]
    except OSError:
        return out
    for line in lines:
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "file":
            out.append(parts[0])
    return out


def encryption():
    """Report whether / and /home are encrypted and whether any swap reaches the disk in clear.

    A device counts as encrypted if a crypt (LUKS) layer sits above it in lsblk's tree.
    zram swap lives in RAM, so it is safe.
    """
    cols = "NAME,PATH,TYPE,FSTYPE,UUID,PARTUUID,MOUNTPOINTS"
    rc, out = run(["lsblk", "-J", "-o", cols])
    if rc != 0 or not out:
        # older lsblk has MOUNTPOINT, not MOUNTPOINTS
        rc, out = run(["lsblk", "-J", "-o", cols.replace("MOUNTPOINTS", "MOUNTPOINT")])
    if rc != 0 or not out:
        return {"available": False, "note": "lsblk did not report the disk layout."}
    try:
        tree = json.loads(out)["blockdevices"]
    except (ValueError, KeyError):
        return {"available": False, "note": "Could not read the disk layout."}

    root = None
    home = None
    swaps = []
    random_keyed = crypttab_random_keyed()

    def mounts(node):
        mp = node.get("mountpoints")
        if mp is None:
            mp = [node.get("mountpoint")]
        return [m for m in mp if m]

    def walk(nodes, chain):
        nonlocal root, home
        for n in nodes:
            here = chain + [n]
            kinds = {x.get("type") for x in here}
            for m in mounts(n):
                if m == "/" and root is None:
                    root = {"device": n["name"], "encrypted": "crypt" in kinds}
                elif m == "/home" and home is None:
                    home = {"device": n["name"], "encrypted": "crypt" in kinds}
                elif m == "[SWAP]":
                    zram = n["name"].startswith("zram")
                    crypt = "crypt" in kinds
                    swaps.append({
                        "name": n["name"],
                        "path": n.get("path") or f"/dev/{n['name']}",
                        "uuid": n.get("uuid") or "",
                        "partuuid": n.get("partuuid") or "",
                        "kind": "zram" if zram else (n.get("type") or "device"),
                        "safe": zram or crypt,
                        "encrypted": crypt,
                        # a swap with a random key is unreadable once power is off
                        "randomKey": crypt and n["name"] in random_keyed,
                    })
            walk(n.get("children") or [], here)

    walk(tree, [])
    exposed = [s for s in swaps if not s["safe"]]
    files = swap_files()
    # Without a separate /home, home lives on / and shares its encryption
    home_sep = home is not None
    home_enc = bool(home["encrypted"]) if home_sep else bool(root and root["encrypted"])
    return {
        "available": root is not None,
        "rootEncrypted": bool(root and root["encrypted"]),
        "rootDevice": root["device"] if root else "",
        "homeSeparate": home_sep,
        "homeEncrypted": home_enc,
        "homeDevice": home["device"] if home_sep else (root["device"] if root else ""),
        "swap": swaps,
        "unencryptedSwap": [s["name"] for s in exposed],
        "swapFiles": files,
        "swapfile": swapfile_state(),
    }


def dns():
    """Report whether lookups go through systemd-resolved and whether they are encrypted.

    The mode is read from resolved's live D-Bus property, not the config file, because
    it can be changed at runtime (for example to get past a captive portal).
    """
    rc, state = run(["systemctl", "is-active", "systemd-resolved.service"])
    if state != "active":
        return {"available": False,
                "note": "systemd-resolved isn't running, so DNS goes wherever the network says."}

    out = {"available": True, "mode": "unknown", "server": ""}

    rc, text = run(["busctl", "--json=short", "get-property", "org.freedesktop.resolve1",
                    "/org/freedesktop/resolve1", "org.freedesktop.resolve1.Manager",
                    "DNSOverTLS"])
    if rc == 0 and text:
        try:
            out["mode"] = json.loads(text).get("data") or "unknown"
        except ValueError:
            pass

    rc, text = run(["resolvectl", "status", "--no-pager"])
    if rc == 0 and text:
        if out["mode"] == "unknown":
            # older resolved has no property; the status text still says
            if "+DNSOverTLS" in text:
                out["mode"] = "yes"
            elif "-DNSOverTLS" in text:
                out["mode"] = "no"
        m = re.search(r"^\s*Current DNS Server:\s*(\S+)", text, re.M)
        if not m:
            m = re.search(r"^\s*DNS Servers:\s*(\S+)", text, re.M)
        if m:
            out["server"] = m.group(1)
        m = re.search(r"^\s*resolv\.conf mode:\s*(\S+)", text, re.M)
        if m:
            out["resolvConf"] = m.group(1)

    out["encrypted"] = out["mode"] in ("yes", "opportunistic")
    out["strict"] = out["mode"] == "yes"
    return out


def mac_addresses():
    """Check whether each network card uses an address other than its permanent one.

    This compares the live address with the permanent one, because NetworkManager's
    policy can be overridden per connection. A card that is not connected usually shows
    its permanent address; that is not a leak, since nothing is sent.
    """
    if not shutil.which("nmcli"):
        return {"available": False, "note": "nmcli is not installed, so MAC addresses can't be read."}

    rc, out = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"])
    if rc != 0:
        return {"available": False, "note": "NetworkManager did not report any devices."}

    devices = []
    for line in out.splitlines():
        parts = line.split(":")
        if len(parts) < 3 or parts[1] not in ("wifi", "ethernet"):
            continue
        name, kind, state = parts[0], parts[1], parts[2]
        rc, info = run(["nmcli", "-t", "--escape", "no", "-f",
                        "GENERAL.HWADDR,GENERAL.PERM-HWADDR", "device", "show", name])
        if rc != 0:
            continue
        addrs = {}
        for row in info.splitlines():
            key, _, value = row.partition(":")
            addrs[key.strip()] = value.strip().replace("\\", "")
        now = addrs.get("GENERAL.HWADDR", "")
        perm = addrs.get("GENERAL.PERM-HWADDR", "")
        devices.append({
            "name": name,
            "kind": kind,
            "connected": state == "connected",
            # some drivers do not report a permanent address, so there is nothing to compare
            "known": bool(now and perm and perm != "(unknown)"),
            "randomized": bool(now and perm and perm != "(unknown)" and now.lower() != perm.lower()),
        })

    policy = ""
    try:
        text = Path("/etc/NetworkManager/conf.d/hypora-mac.conf").read_text()
        m = re.search(r"^\s*wifi\.cloned-mac-address\s*=\s*(\S+)", text, re.M)
        if m:
            policy = m.group(1)
    except OSError:
        pass

    return {
        "available": bool(devices),
        "note": "" if devices else "No Wi-Fi or ethernet device to report on.",
        "policy": policy,
        "devices": devices,
        # only connected devices count; a parked card tells us nothing
        "activeLeaks": [d["name"] for d in devices
                        if d["connected"] and d["known"] and not d["randomized"]],
    }


def _automatic_conf():
    """Merge dnf5-automatic's settings: packaged defaults first, then local overrides."""
    import configparser
    parser = configparser.ConfigParser(interpolation=None)
    for path in ("/usr/share/dnf5/dnf5-plugins/automatic.conf",
                 "/etc/dnf/dnf5-plugins/automatic.conf",
                 "/etc/dnf/automatic.conf"):
        try:
            parser.read_string(Path(path).read_text(), source=path)
        except (OSError, configparser.Error):
            continue
    if not parser.has_section("commands"):
        return {}
    return dict(parser["commands"])


def updates():
    """Report whether security updates install on their own, for packages and flatpaks.

    There are two timers because dnf cannot see flatpaks and the flatpak timer cannot
    see system packages.
    """
    out = {"available": True}

    timer = ""
    for candidate in ("dnf5-automatic.timer", "dnf-automatic.timer"):
        rc, state = run(["systemctl", "is-enabled", candidate])
        if state and state != "not-found":
            timer, out["packagesState"] = candidate, state
            break
    conf = _automatic_conf()
    applies = str(conf.get("apply_updates", "no")).strip().lower() in ("yes", "true", "1")
    out["packagesTimer"] = timer
    out["packagesEnabled"] = bool(timer) and out.get("packagesState") == "enabled"
    out["packagesApply"] = applies
    out["upgradeType"] = str(conf.get("upgrade_type", "")).strip()
    if not timer:
        out["packagesNote"] = "dnf's automatic update timer isn't installed."
    elif not out["packagesEnabled"]:
        out["packagesNote"] = "The timer exists but isn't enabled, so nothing updates on its own."
    elif not applies:
        out["packagesNote"] = "Updates are downloaded but not installed (apply_updates is off)."

    if timer:
        _, last = run(["systemctl", "show", "-p", "LastTriggerUSec", "--value", timer])
        out["packagesLastRun"] = last if last and last != "n/a" else ""

    rc, state = run(["systemctl", "is-enabled", "hypora-flatpak-update.timer"])
    out["flatpakState"] = state or "not-found"
    out["flatpakEnabled"] = state == "enabled"
    return out


def firewall_detail():
    """Read the default zone and its open ports from firewalld's config files.

    Needs root (/etc/firewalld is mode 0750). Reading files instead of asking firewalld
    over D-Bus means this cannot raise a second polkit prompt.
    """
    out = {}
    try:
        text = Path("/etc/firewalld/firewalld.conf").read_text()
    except OSError as e:
        return {"note": f"Could not read firewalld's configuration: {e}"}
    m = re.search(r"^\s*DefaultZone\s*=\s*(\S+)", text, re.M)
    zone = m.group(1).strip() if m else ""
    out["zone"] = zone
    out["permissive"] = zone == "FedoraWorkstation"

    ports = []
    # a zone edited locally is in /etc; otherwise use the stock one in /usr/lib
    for base in ("/etc/firewalld/zones", "/usr/lib/firewalld/zones"):
        path = Path(base) / f"{zone}.xml"
        if not path.is_file():
            continue
        try:
            import xml.etree.ElementTree as ET
            for el in ET.parse(str(path)).getroot().findall("port"):
                ports.append(f"{el.get('port')}/{el.get('protocol')}")
        except Exception:
            pass
        break
    out["openPorts"] = ports
    return out


def deep():
    """The two readings that need root. Run as `pkexec hypora-security deep`.

    It does not call status(): that reads the user's own settings, which would be root's
    under pkexec.
    """
    return {"firmware": firmware_checks(), "firewallDetail": firewall_detail()}


def firewall(deep=False):
    """Report whether firewalld runs. With `deep`, also its zone and open ports."""
    if not shutil.which("firewall-cmd"):
        return {"available": False, "deep": deep, "note": "firewalld is not installed."}
    _, state = run(["systemctl", "is-active", "firewalld.service"])
    if state != "active":
        return {"available": True, "deep": deep, "running": False,
                "note": "firewalld is installed but not running, so nothing is filtering."}
    out = {"available": True, "deep": deep, "running": True}
    if not deep:
        return out
    _, zone = run(["firewall-cmd", "--get-default-zone"])
    rc, ports = run(["firewall-cmd", f"--zone={zone}", "--list-ports"]) if zone else (1, "")
    out["zone"] = zone
    out["openPorts"] = ports.split() if rc == 0 and ports else []
    # FedoraWorkstation opens ports 1025-65535; public is closed by default
    out["permissive"] = zone == "FedoraWorkstation"
    return out


def selinux():
    if not shutil.which("getenforce"):
        return {"available": False, "note": "SELinux tools are not installed."}
    _, mode = run(["getenforce"])
    out = {"available": True, "mode": mode.lower() or "unknown"}
    try:
        text = SELINUX_CONFIG.read_text()
        m = re.search(r"^\s*SELINUX\s*=\s*(\w+)", text, re.M)
        if m:
            out["boot"] = m.group(1).lower()
        m = re.search(r"^\s*SELINUXTYPE\s*=\s*(\w+)", text, re.M)
        if m:
            out["policy"] = m.group(1)
    except OSError:
        pass
    # going from disabled to enforcing needs a full relabel on the next boot
    out["needsRelabel"] = out["mode"] == "disabled"
    return out


# The video class is on the USB interface, not the device. A webcam's device class is
# 0xef (miscellaneous), so checking the device would miss every one.
USB_VIDEO_CLASS = "0e"

# Intel MIPI/IPU cameras are PCI controllers driven by intel-ipu6, not uvcvideo.
PCI_CAMERA_CLASSES = ("0400", "0480")


def _sysread(p):
    try:
        return p.read_text().strip()
    except OSError:
        return ""


def camera():
    """Report whether there is a camera, whether it is usable and whether we can switch it off.

    This asks sysfs which hardware exists. It does not rely on /dev/video* or the driver
    being loaded: after switching the camera off both disappear, and the window would
    then claim there is no camera and hide the switch to turn it back on.
    """
    nodes = sorted(str(p) for p in Path("/dev").glob("video*"))
    try:
        mods = Path("/proc/modules").read_text()
    except OSError:
        mods = ""
    uvc_loaded = bool(re.search(r"^uvcvideo ", mods, re.M))

    # USB cameras (still listed when the driver is unloaded)
    uvc = []
    usb = Path("/sys/bus/usb/devices")
    if usb.is_dir():
        for iface in sorted(usb.glob("*:*")):
            if _sysread(iface / "bInterfaceClass") != USB_VIDEO_CLASS:
                continue
            parent = iface.parent / iface.name.split(":")[0]
            uvc.append(_sysread(parent / "product")
                       or _sysread(iface / "interface")
                       or iface.name)

    # MIPI/IPU cameras
    mipi = []
    pci = Path("/sys/bus/pci/devices")
    if pci.is_dir():
        for dev in sorted(pci.iterdir()):
            cls = _sysread(dev / "class")            # format 0xCCSSPP
            if len(cls) < 6 or cls[2:6] not in PCI_CAMERA_CLASSES:
                continue
            drv = ""
            if (dev / "driver").is_symlink():
                drv = Path(os.readlink(dev / "driver")).name
            # The same PCI class is used by capture cards and audio DSPs, so only count
            # devices with no driver yet or a camera driver.
            if drv and not drv.startswith(("intel-ipu", "ipu")):
                continue
            mipi.append(dev.name)

    present = bool(uvc or mipi or nodes or uvc_loaded)
    # the switch unloads uvcvideo, so it only controls USB cameras
    controllable = bool(uvc) or uvc_loaded

    out = {
        "devices": nodes,
        "present": present,
        "enabled": bool(nodes),
        "driver": "uvcvideo" if uvc_loaded else "",
        "uvc": uvc,
        "mipi": mipi,
        "controllable": controllable,
    }
    if present and not controllable:
        out["note"] = ("The camera on this machine is a MIPI/IPU sensor rather than a USB "
                       "one, so it is driven by intel-ipu6 and not uvcvideo — this switch "
                       "cannot turn it off.")
    return out


def location():
    rc, state = run(["systemctl", "is-enabled", "geoclue.service"])
    if state == "" and rc != 0:
        return {"available": False, "note": "GeoClue is not installed, so nothing requests your location."}
    return {"available": True, "enabled": state != "masked", "state": state}


def file_history():
    out = {}
    if shutil.which("gsettings"):
        rc, v = run(["gsettings", "get", "org.gnome.desktop.privacy", "remember-recent-files"])
        if rc == 0:
            out["remember"] = v.strip() == "true"
        rc, v = run(["gsettings", "get", "org.gnome.desktop.privacy", "recent-files-max-age"])
        if rc == 0:
            try:
                out["maxAge"] = int(v.strip())
            except ValueError:
                pass
    recent = Path.home() / ".local/share/recently-used.xbel"
    out["entries"] = len(re.findall(r"<bookmark ", recent.read_text(errors="replace"))) if recent.is_file() else 0
    out["available"] = "remember" in out
    if not out["available"]:
        out["note"] = "The GNOME privacy settings schema isn't installed."
    return out


def status(deep=False):
    """Everything the Security window shows.

    Without `deep`, no call here can ask polkit for a password.
    """
    out = {
        "secureBoot": secure_boot(),
        "encryption": encryption(),
    }
    if deep:
        out["firmware"] = firmware_checks()
    out.update({
        "dns": dns(),
        "mac": mac_addresses(),
        "firewall": firewall(deep),
        "updates": updates(),
        "selinux": selinux(),
        "camera": camera(),
        "location": location(),
        "fileHistory": file_history(),
    })
    return out


# ---------- actions (root) ----------

def need_root():
    if os.geteuid() != 0:
        print("This needs root; run it with pkexec.", file=sys.stderr)
        sys.exit(1)


def set_selinux(mode):
    need_root()
    if mode not in ("enforcing", "permissive"):
        sys.exit("mode must be enforcing or permissive")
    rc, _ = run(["setenforce", "1" if mode == "enforcing" else "0"])
    sys.exit(rc)


def set_selinux_boot(mode):
    need_root()
    # "disabled" is not accepted on purpose: turning SELinux off is not something a
    # settings window should offer. Edit /etc/selinux/config by hand if you need it.
    if mode not in ("enforcing", "permissive"):
        sys.exit("mode must be enforcing or permissive")
    try:
        text = SELINUX_CONFIG.read_text()
    except OSError as e:
        sys.exit(f"cannot read {SELINUX_CONFIG}: {e}")
    new, n = re.subn(r"^\s*SELINUX\s*=\s*\w+", f"SELINUX={mode}", text, count=1, flags=re.M)
    if n == 0:
        new = text.rstrip("\n") + f"\nSELINUX={mode}\n"
    atomic_write(SELINUX_CONFIG, new)
    # relabel on the next boot so enforcing can work
    Path("/.autorelabel").touch()
    print(f"SELINUX={mode} set for the next boot")


def set_camera(state):
    need_root()
    if state == "off":
        rc, _ = run(["modprobe", "-r", "uvcvideo"])
        if rc != 0:
            sys.exit("Could not unload uvcvideo — something is probably using the camera.")
    elif state == "on":
        rc, _ = run(["modprobe", "uvcvideo"])
        if rc != 0:
            sys.exit("Could not load uvcvideo.")
    else:
        sys.exit("state must be on or off")


def set_location(state):
    need_root()
    if state == "off":
        run(["systemctl", "stop", "geoclue.service"])
        rc, _ = run(["systemctl", "mask", "geoclue.service"])
    elif state == "on":
        rc, _ = run(["systemctl", "unmask", "geoclue.service"])
    else:
        sys.exit("state must be on or off")
    sys.exit(rc)


# ---------- swapfile on the encrypted root ----------
#
# A swapfile inside the encrypted root is encrypted with it. The only persistent change
# is one fstab line with `nofail`, so the worst failure is a boot without swap. (An older
# version encrypted a swap partition in place and could leave the machine unbootable.)
# It is only offered when / is encrypted.

FSTAB = Path("/etc/fstab")
SWAP_SUBVOL = Path("/swap")
SWAPFILE = Path("/swap/swapfile")
DEFAULT_SWAPFILE_SIZE = "4g"


def _backup(path):
    """Copy a boot-critical file to a timestamped backup before editing it."""
    if not path.exists():
        return None
    dest = path.with_name(path.name + time.strftime(".hypora-%Y%m%d-%H%M%S"))
    shutil.copy2(path, dest)
    return dest


def root_encrypted():
    """True if / sits on a dm-crypt (LUKS) volume."""
    rc, src = run(["findmnt", "-fno", "SOURCE", "/"])
    if rc != 0 or not src:
        return False
    src = src.split("[")[0]                      # btrfs reports /dev/x[/subvol]
    rc, kind = run(["lsblk", "-no", "TYPE", src])
    return kind.splitlines()[0].strip() == "crypt" if kind else False


def swapfile_state():
    """What the window needs to decide which swapfile button to show."""
    rc, fstype = run(["findmnt", "-fno", "FSTYPE", "/"])
    fstype = fstype.strip() if rc == 0 else ""
    active = False
    try:
        for line in Path("/proc/swaps").read_text().splitlines()[1:]:
            if line.split() and line.split()[0] == str(SWAPFILE):
                active = True
    except OSError:
        pass
    return {
        "path": str(SWAPFILE),
        "exists": SWAPFILE.is_file(),
        "active": active,
        "rootFs": fstype,
        "rootEncrypted": root_encrypted(),
        "supported": fstype in ("btrfs", "ext4", "xfs"),
    }


def add_swapfile(arg=""):
    need_root()
    size = arg or DEFAULT_SWAPFILE_SIZE
    if not re.fullmatch(r"\d+[kmgKMG]?", size):
        sys.exit(f"Size must look like 4g or 512m, not {size!r}")

    st = swapfile_state()
    if st["exists"]:
        sys.exit(f"{SWAPFILE} already exists. Remove it first with: "
                 "hypora-security remove-swapfile")
    if not st["rootEncrypted"]:
        sys.exit("/ is not encrypted, so a swapfile on it would be plaintext swap — which "
                 "is the problem this is meant to avoid, not the fix. Encrypt the root "
                 "volume (only possible at install time) first.")
    if not st["supported"]:
        sys.exit(f"Don't know how to make a swapfile on {st['rootFs'] or 'this filesystem'}.")

    # A strict umask from the start, so the file is never briefly world-readable
    old_umask = os.umask(0o077)
    try:
        _create_swapfile(st, size)
    finally:
        os.umask(old_umask)

    os.chmod(SWAPFILE, 0o600)
    rc, out = run(["swapon", str(SWAPFILE)], timeout=60)
    if rc != 0:
        SWAPFILE.unlink(missing_ok=True)
        sys.exit(f"Could not activate the swapfile, so it was removed: {out.strip()[:200]}")

    # Only write fstab once the swapfile is known to work
    _backup(FSTAB)
    text = FSTAB.read_text() if FSTAB.exists() else ""
    if not re.search(rf"^\s*{re.escape(str(SWAPFILE))}\s", text, re.M):
        if text and not text.endswith("\n"):
            text += "\n"
        text += f"{SWAPFILE} none swap defaults,nofail 0 0\n"
        atomic_write(FSTAB, text)
    run(["systemctl", "daemon-reload"])

    print(f"{SWAPFILE} created ({size}) and active. It is inside the encrypted root, so it "
          "is encrypted with everything else.")


def _create_swapfile(st, size):
    if st["rootFs"] == "btrfs":
        # Own subvolume, so snapshots never capture the swapfile
        if not SWAP_SUBVOL.exists():
            rc, out = run(["btrfs", "subvolume", "create", str(SWAP_SUBVOL)], timeout=60)
            if rc != 0:
                sys.exit(f"Could not create {SWAP_SUBVOL}: {out.strip()[:200]}")
        # mkswapfile sets the NOCOW and no-compression flags btrfs requires for swap
        rc, out = run(["btrfs", "filesystem", "mkswapfile", "--size", size, str(SWAPFILE)],
                      timeout=300)
        if rc != 0:
            # remove a partial file, or every retry would say "already exists"
            SWAPFILE.unlink(missing_ok=True)
            sys.exit(f"Could not create the swapfile: {out.strip()[:300]}")
    else:
        SWAP_SUBVOL.mkdir(parents=True, exist_ok=True)
        rc, out = run(["fallocate", "-l", size, str(SWAPFILE)], timeout=300)
        if rc != 0:
            SWAPFILE.unlink(missing_ok=True)
            sys.exit(f"Could not allocate {SWAPFILE}: {out.strip()[:200]}")
        os.chmod(SWAPFILE, 0o600)
        rc, out = run(["mkswap", str(SWAPFILE)], timeout=120)
        if rc != 0:
            SWAPFILE.unlink(missing_ok=True)
            sys.exit(f"mkswap failed: {out.strip()[:200]}")


def remove_swapfile(arg=""):
    need_root()
    if not SWAPFILE.is_file():
        print(f"No {SWAPFILE} to remove.")
        return
    run(["swapoff", str(SWAPFILE)], timeout=120)
    # Check /proc/swaps, not swapoff's exit code (which is also non-zero if it was never
    # active). If it is still in use, stop and change nothing.
    if swapfile_state()["active"]:
        sys.exit(f"{SWAPFILE} is still in use, so nothing was changed. This usually means "
                 "there is not enough free memory to take its contents back; close some "
                 "applications and try again.")

    _backup(FSTAB)
    if FSTAB.exists():
        kept = [l for l in FSTAB.read_text().splitlines()
                if not re.match(rf"^\s*{re.escape(str(SWAPFILE))}\s", l)]
        atomic_write(FSTAB, "\n".join(kept) + "\n")

    SWAPFILE.unlink(missing_ok=True)
    run(["systemctl", "daemon-reload"])
    print(f"{SWAPFILE} removed.")


def main(argv):
    if len(argv) < 2 or argv[1] == "status":
        print(json.dumps(status(deep="--deep" in argv), indent=2))
        return 0
    if argv[1] == "deep":
        print(json.dumps(deep(), indent=2))
        return 0
    if argv[1] == "firmware":
        print(json.dumps(firmware_checks(), indent=2))
        return 0
    cmd, arg = argv[1], (argv[2] if len(argv) > 2 else "")
    actions = {
        "selinux": set_selinux,
        "selinux-boot": set_selinux_boot,
        "camera": set_camera,
        "location": set_location,
        "add-swapfile": add_swapfile,
        "remove-swapfile": remove_swapfile,
    }
    if cmd not in actions:
        print(__doc__, file=sys.stderr)
        return 2
    actions[cmd](arg)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
