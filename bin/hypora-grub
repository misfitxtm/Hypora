#!/usr/bin/env python3
"""hypora-grub: put the active theme's colours on the GRUB boot menu.

    hypora-grub print      show the theme.txt that would be written (no root)
    hypora-grub status     show what GRUB is currently configured to do
    hypora-grub apply      install the theme and switch GRUB to graphics mode (root)
    hypora-grub remove     take it back off and restore the text menu (root)

A deliberately plain menu: the wordmark, the entries, one accent bar on the selected one,
and the keys along the bottom. No window chrome, no distro branding, nothing that moves.

Three things about GRUB make this more than dropping a file in place:

  * **A theme does nothing in text mode.** Fedora ships GRUB_TERMINAL_OUTPUT="console",
    which is exactly that, so a theme installed without changing it is invisible and looks
    like the theme is broken. `apply` switches it to gfxterm and sets a gfxmode.
  * **GRUB has no system fonts.** It reads its own .pf2 format, so a font has to be
    converted with grub2-mkfont. If that fails the theme still works — GRUB falls back to
    its built-in font, which is legible but small.
  * **The selected row cannot be filled with a colour.** selected_item_color sets the text,
    not the background, so the accent bar behind the current entry has to be an image. It is
    a 1x1 PNG, stretched by GRUB's nine-slice scaler.

Everything here is written with the standard library, PNG included, so it adds no
dependency beyond grub2-mkconfig and (optionally) grub2-mkfont.
"""
import os
import re
import shutil
import struct
import subprocess
import sys
import zlib
from pathlib import Path

THEME_NAME = "hypora"
GRUB_DEFAULT = Path("/etc/default/grub")
# The keys apply() owns. Anything else in /etc/default/grub is left exactly as it was.
MANAGED = ("GRUB_THEME", "GRUB_TERMINAL_OUTPUT", "GRUB_GFXMODE", "GRUB_GFXPAYLOAD_LINUX")

# Palette keys this needs. A theme missing one of these isn't usable here.
KEYS = ("background", "surface", "foreground", "dim", "accent", "selection")


def home():
    """The invoking user's home, not root's — apply() runs under sudo."""
    who = os.environ.get("SUDO_USER")
    if who:
        import pwd
        try:
            return Path(pwd.getpwnam(who).pw_dir)
        except KeyError:
            pass
    return Path.home()


def palette():
    """(theme name, {key: '#rrggbb'}) for the theme that is currently applied."""
    conf = home() / ".config/hypora"
    try:
        name = (conf / "current/name").read_text().strip()
    except OSError:
        sys.exit("No theme is applied yet; run hypora-theme first.")
    colors = conf / "themes" / name / "colors.toml"
    try:
        text = colors.read_text()
    except OSError as e:
        sys.exit(f"Cannot read {colors}: {e}")

    out = {}
    for key in KEYS:
        m = re.search(rf'^{key}\s*=\s*"(#[0-9a-fA-F]{{6}})"', text, re.M)
        if not m:
            sys.exit(f"{colors} has no '{key}'; the boot menu needs all of: "
                     + ", ".join(KEYS))
        out[key] = m.group(1).lower()
    return name, out


# ---------- the theme ----------

def theme_txt(colors):
    """GRUB's theme format. Percentages so it holds up at any resolution.

    The layout is the point: a wordmark well above centre, the menu in the middle third,
    the keys at the bottom. GRUB positions by absolute or percentage offsets only — there
    is no centring primitive — so the menu is given a 60% width at 20% from the left, which
    centres it, and `align = "center"` handles the text inside each label.
    """
    c = colors
    return f"""# Hypora boot menu — generated by hypora-grub from the active theme.
# Do not edit: `hypora-theme <name>` rewrites this. Change bin/hypora-grub instead.

desktop-color: "{c['background']}"
title-text: ""
terminal-font: "Hypora Mono Regular 16"
terminal-left: "10%"
terminal-top: "10%"
terminal-width: "80%"
terminal-height: "80%"

# Wordmark. A label rather than an image: it stays crisp at every resolution, and GRUB
# loads it with no PNG decode at boot.
+ label {{
    top = 22%
    left = 0
    width = 100%
    align = "center"
    text = "HYPORA"
    color = "{c['accent']}"
    font = "Hypora Mono Bold 28"
}}

+ label {{
    top = 29%
    left = 0
    width = 100%
    align = "center"
    text = "Select a kernel to boot"
    color = "{c['dim']}"
    font = "Hypora Mono Regular 14"
}}

+ boot_menu {{
    left = 20%
    width = 60%
    top = 38%
    height = 42%

    item_font = "Hypora Mono Regular 16"
    item_color = "{c['foreground']}"
    selected_item_color = "{c['background']}"
    item_height = 34
    item_spacing = 4
    item_padding = 0
    item_icon_space = 0
    icon_width = 0
    icon_height = 0

    # The accent bar behind the current entry. GRUB cannot fill a rectangle with a colour,
    # so this is a stretched 1x1 PNG; see select_png() below.
    selected_item_pixmap_style = "select_*.png"

    scrollbar = true
    scrollbar_width = 3
    scrollbar_thumb = "thumb_*.png"
}}

# Countdown, shown only while the timeout is running down.
+ progress_bar {{
    id = "__timeout__"
    left = 20%
    width = 60%
    top = 84%
    height = 4
    show_text = false
    fg_color = "{c['accent']}"
    bg_color = "{c['selection']}"
    border_color = "{c['selection']}"
}}

+ label {{
    top = 90%
    left = 0
    width = 100%
    align = "center"
    text = "↑↓ select    Enter boot    e edit    c console"
    color = "{c['dim']}"
    font = "Hypora Mono Regular 13"
}}
"""


# ---------- PNG ----------

def write_png(path, rgba):
    """A 1x1 RGBA PNG. GRUB's nine-slice scaler stretches it to whatever it needs.

    Hand-rolled because this is four chunks and a CRC, and pulling in a image library to
    emit four bytes of pixel data would be the larger cost.
    """
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))

    raw = bytes([0]) + bytes(rgba)        # one scanline, filter type 0
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9))
           + chunk(b"IEND", b""))
    path.write_bytes(png)


def rgb(hexstr):
    h = hexstr.lstrip("#")
    return [int(h[i:i + 2], 16) for i in (0, 2, 4)]


def write_assets(dest, colors):
    """The centre slice of each nine-slice pixmap GRUB asks for.

    Only `_c` is written. GRUB treats the eight missing edge and corner slices as empty,
    which gives a clean square bar — the alternative is eight more files to describe a
    rounded corner nobody looks at for four seconds.
    """
    write_png(dest / "select_c.png", rgb(colors["accent"]) + [255])
    write_png(dest / "thumb_c.png", rgb(colors["dim"]) + [255])


# ---------- font ----------

def find_font():
    """A TTF to convert. Hypora installs the Nerd Font system-wide; fall back to anything."""
    candidates = [
        "/usr/local/share/fonts/JetBrainsMonoNerdFont/JetBrainsMonoNerdFont-Regular.ttf",
        "/usr/local/share/fonts/JetBrainsMonoNerdFont/JetBrainsMonoNLNerdFont-Regular.ttf",
        "/usr/share/fonts/jetbrains-mono-fonts/JetBrainsMono-Regular.ttf",
        "/usr/share/fonts/liberation-mono/LiberationMono-Regular.ttf",
        "/usr/share/fonts/liberation-mono-fonts/LiberationMono-Regular.ttf",
    ]
    for p in candidates:
        if Path(p).is_file():
            return Path(p)
    # Anything monospace, rather than giving up
    rc, out = run(["fc-match", "-f", "%{file}", "monospace"])
    if rc == 0 and out and Path(out).is_file():
        return Path(out)
    return None


def bold_of(regular):
    """The bold cut beside a regular one, if it is there."""
    for suffix in ("-Bold.ttf", "Bold.ttf"):
        cand = Path(str(regular).replace("-Regular.ttf", suffix))
        if cand.is_file() and cand != regular:
            return cand
    return None


def make_fonts(dest):
    """Convert to .pf2 at the sizes theme.txt asks for. Returns a list of what failed.

    GRUB has no concept of scaling a font: each size is a separate file, and a size the
    theme names but the directory lacks silently falls back to the built-in font. So the
    sizes here and the sizes in theme_txt() have to agree.
    """
    if shutil.which("grub2-mkfont") is None:
        return ["grub2-mkfont is not installed"]
    regular = find_font()
    if regular is None:
        return ["no usable TTF found to convert"]
    bold = bold_of(regular) or regular

    # -n takes the *family* only. grub2-mkfont appends the style and size itself, reading
    # the style from the font file — so "Hypora Mono" plus a bold TTF at 28 becomes
    # "Hypora Mono Bold 28", which is what theme.txt asks for. Passing the full name here
    # instead produces "Hypora Mono Regular 16 Regular 16", which matches nothing in the
    # theme, and GRUB answers that by silently using its built-in font.
    FAMILY = "Hypora Mono"
    jobs = [(regular, s, f"regular-{s}.pf2") for s in (13, 14, 16)]
    jobs += [(bold, 28, "bold-28.pf2")]

    problems = []
    for src, size, out in jobs:
        rc, err = run(["grub2-mkfont", "-s", str(size), "-n", FAMILY,
                       "-o", str(dest / out), str(src)])
        if rc != 0:
            problems.append(f"{out}: {err.strip() or 'grub2-mkfont failed'}")
    return problems


# ---------- helpers ----------

def run(cmd):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except (OSError, subprocess.SubprocessError) as e:
        return 1, str(e)


def need_root():
    if os.geteuid() != 0:
        sys.exit("This writes to /boot and /etc/default/grub, so it needs root:\n"
                 f"    sudo hypora-grub {sys.argv[1] if len(sys.argv) > 1 else 'apply'}")


def grub_dir():
    """Fedora keeps GRUB's files in /boot/grub2 on both BIOS and UEFI since F34."""
    for p in ("/boot/grub2", "/boot/grub"):
        if Path(p).is_dir():
            return Path(p)
    return None


def grub_cfg(gdir):
    """What to regenerate.

    On Fedora /boot/efi/EFI/fedora/grub.cfg is a stub that chain-loads this one, so this is
    the only file that needs rewriting — writing the stub instead is the classic way to end
    up with a menu that never changes.
    """
    return gdir / "grub.cfg"


# Lines this script owns carry MARK, so a later run can tell its own work from yours; any
# pre-existing value is parked on a SAVE line directly above. That distinction is the whole
# point: without it, every theme switch commented out the previous switch's line, and three
# switches left nine dead lines that `remove` then restored as live config.
MARK = "# set by hypora-grub"
SAVE = "# was, before hypora-grub: "


def set_keys(text, values):
    """Set each key, preserving any pre-existing value once and only once."""
    lines = text.splitlines()
    for key, val in values.items():
        ours = f"{key}={val}  {MARK}"
        idx = next((i for i, l in enumerate(lines)
                    if re.match(rf"^\s*{key}=", l)), None)
        if idx is None:
            lines.append(ours)
        elif MARK in lines[idx]:
            lines[idx] = ours                        # already ours: update in place
        else:
            lines[idx] = SAVE + lines[idx].strip()   # yours: park it, then add ours
            lines.insert(idx + 1, ours)
    return "\n".join(lines) + "\n"


def unset_keys(text, keys):
    """Drop our lines and put back whatever was there before them."""
    out = []
    for line in text.splitlines():
        if MARK in line and any(re.match(rf"^\s*{k}=", line) for k in keys):
            continue
        m = re.match(rf"^{re.escape(SAVE)}(.*)$", line)
        if m:
            out.append(m.group(1))
            continue
        out.append(line)
    return "\n".join(out) + "\n"


# ---------- commands ----------

def cmd_print():
    name, colors = palette()
    print(f"# theme: {name}")
    print(theme_txt(colors))


def cmd_status():
    gdir = grub_dir()
    print(f"GRUB directory:  {gdir or 'not found — this system may not use GRUB'}")
    if gdir:
        installed = gdir / "themes" / THEME_NAME / "theme.txt"
        print(f"Hypora theme:    {'installed' if installed.is_file() else 'not installed'}"
              f"  ({installed})")
    try:
        text = GRUB_DEFAULT.read_text()
    except OSError as e:
        print(f"{GRUB_DEFAULT}: {e}")
        return 0
    print(f"\n{GRUB_DEFAULT}:")
    for key in MANAGED:
        m = re.search(rf"^\s*{key}=(.*)$", text, re.M)
        print(f"  {key:24s} {m.group(1).strip() if m else '(unset)'}")
    term = re.search(r'^\s*GRUB_TERMINAL_OUTPUT=(.*)$', text, re.M)
    if term and "console" in term.group(1):
        print("\n  GRUB is in text mode, so no theme will be shown. `apply` changes that.")
    return 0


def cmd_apply():
    need_root()
    gdir = grub_dir()
    if gdir is None:
        sys.exit("No /boot/grub2 or /boot/grub, so this system does not appear to use GRUB.")
    if shutil.which("grub2-mkconfig") is None:
        sys.exit("grub2-mkconfig is not installed.")

    name, colors = palette()
    dest = gdir / "themes" / THEME_NAME
    dest.mkdir(parents=True, exist_ok=True)

    (dest / "theme.txt").write_text(theme_txt(colors))
    write_assets(dest, colors)
    problems = make_fonts(dest)

    # /etc/default/grub. Backed up once per run, since getting this wrong is a machine that
    # boots to a GRUB rescue prompt.
    try:
        text = GRUB_DEFAULT.read_text()
    except OSError as e:
        sys.exit(f"Cannot read {GRUB_DEFAULT}: {e}")
    import time
    backup = GRUB_DEFAULT.with_name(GRUB_DEFAULT.name + time.strftime(".hypora-%Y%m%d-%H%M%S"))
    shutil.copy2(GRUB_DEFAULT, backup)

    new = set_keys(text, {
        "GRUB_THEME": str(dest / "theme.txt"),
        # The one that actually matters: a theme in console mode is invisible
        "GRUB_TERMINAL_OUTPUT": '"gfxterm"',
        "GRUB_GFXMODE": "auto",
        # Hand the mode to the kernel so the handover doesn't flash back to text
        "GRUB_GFXPAYLOAD_LINUX": "keep",
    })
    GRUB_DEFAULT.write_text(new)

    cfg = grub_cfg(gdir)
    rc, out = run(["grub2-mkconfig", "-o", str(cfg)])
    if rc != 0:
        shutil.copy2(backup, GRUB_DEFAULT)
        sys.exit(f"grub2-mkconfig failed, so {GRUB_DEFAULT} was put back:\n{out[-1500:]}")

    print(f"Boot menu themed with {name}.")
    print(f"  theme:   {dest}/theme.txt")
    print(f"  config:  {cfg}")
    print(f"  backup:  {backup}")
    for p in problems:
        print(f"  note: {p}; GRUB's built-in font will be used instead", file=sys.stderr)
    print("It changes on screen at the next boot.")
    return 0


def cmd_remove():
    need_root()
    gdir = grub_dir()
    if gdir is None:
        sys.exit("No GRUB directory found.")
    try:
        text = GRUB_DEFAULT.read_text()
    except OSError as e:
        sys.exit(f"Cannot read {GRUB_DEFAULT}: {e}")

    import time
    backup = GRUB_DEFAULT.with_name(GRUB_DEFAULT.name + time.strftime(".hypora-%Y%m%d-%H%M%S"))
    shutil.copy2(GRUB_DEFAULT, backup)
    GRUB_DEFAULT.write_text(unset_keys(text, MANAGED))

    shutil.rmtree(gdir / "themes" / THEME_NAME, ignore_errors=True)

    cfg = grub_cfg(gdir)
    rc, out = run(["grub2-mkconfig", "-o", str(cfg)])
    if rc != 0:
        shutil.copy2(backup, GRUB_DEFAULT)
        sys.exit(f"grub2-mkconfig failed, so {GRUB_DEFAULT} was put back:\n{out[-1500:]}")
    print(f"Boot menu theme removed. Backup: {backup}")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    table = {"print": cmd_print, "status": cmd_status,
             "apply": cmd_apply, "remove": cmd_remove}
    if cmd not in table:
        print(__doc__, file=sys.stderr)
        return 2
    return table[cmd]() or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
