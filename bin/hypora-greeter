#!/usr/bin/env python3
"""hypora-greeter: carry Hypora's main display through to the SDDM login screen.

    hypora-greeter status            what the greeter is currently told
    hypora-greeter set <OUTPUT>      put the login screen on that output (needs root)
    hypora-greeter clear             go back to letting Hyprland decide (needs root)

The login screen runs as the `sddm` user, in its own Hyprland instance started from
/usr/share/sddm/themes/hypora/hyprland.lua. It never reads your ~/.config, so the main
display chosen in Display Settings means nothing to it: the greeter lands on whichever
output Hyprland focuses first, which is why a second screen can end up hosting the login
prompt and then stop being the main display the moment you log in.

This writes one small generated file next to the greeter's config, which that config loads
if it is present. Root-owned, because anything the greeter reads before login must not be
writable by the user it is about to authenticate — a monitor name is harmless, but the
file it lands in is executed as Lua by a process running before anyone has logged in.
That is also why the output name is validated here rather than trusted: it arrives from a
GUI running as your user.

Installed to /usr/local/bin by install.sh and reached through pkexec, like the other
root-owned helpers.
"""
import os
import re
import shlex
import sys
from pathlib import Path

THEME_DIR = Path("/usr/share/sddm/themes/hypora")
GENERATED = THEME_DIR / "primary-monitor.lua"
CURSOR_SH = THEME_DIR / "cursor-to-primary.sh"

# Connector names as Hyprland reports them: eDP-1, DP-3, HDMI-A-1, DVI-D-1. Deliberately
# tight — this string is interpolated into a Lua file and into a shell command, and the
# only safe way to do that is to refuse anything that isn't obviously a connector.
OUTPUT_RE = re.compile(r"\A[A-Za-z][A-Za-z0-9-]{0,31}\Z")


def need_root():
    """Refuse without root, suggesting the same command under sudo.

    shlex.quote on every argument, because this prints something the reader is meant to
    copy and run: echoing an argument back raw turns `set 'DP-3; rm -rf /'` into a
    suggestion that does exactly that. Validation runs before this is ever reached, but a
    hint that only stays safe because of a check somewhere else is a bad hint.
    """
    if os.geteuid() != 0:
        args = " ".join(shlex.quote(a) for a in sys.argv[1:])
        sys.exit(f"This writes to /usr/share/sddm, so it needs root:\n"
                 f"    sudo hypora-greeter {args}")


def cmd_status():
    if not GENERATED.is_file():
        print("The greeter is not told anything; Hyprland picks the output itself.")
        return 0
    text = GENERATED.read_text()
    m = re.search(r'focusmonitor ([A-Za-z0-9-]+)', text)
    print(f"Login screen is sent to: {m.group(1)}" if m
          else f"{GENERATED} exists but names no output; run `hypora-greeter clear`.")
    return 0


def cmd_set(name):
    # Validate before the root check, so a bad name is rejected on its own terms rather
    # than first being quoted back inside a suggested sudo command.
    if not OUTPUT_RE.match(name):
        sys.exit(f"Not a plausible output name: {name!r}\n"
                 "Expected something like eDP-1, DP-3 or HDMI-A-1.")
    need_root()
    if not THEME_DIR.is_dir():
        sys.exit(f"{THEME_DIR} does not exist; is the Hypora SDDM theme installed?")

    # exec_cmd rather than a monitor or window rule: this file is loaded by the config that
    # draws the login screen, and a key some Hyprland version doesn't recognise would be a
    # config error at the one moment there is no way to log in and fix it. A shell command
    # that fails just leaves the greeter where it would have been anyway.

    # Dispatched through hyprctl, never by calling hl.dispatch in this file.
    #
    # Four wrong attempts, each informing the next:
    #   1. `hyprctl dispatch movecursor X Y` — hyprctl evaluates its argument as Lua, so
    #      this became the malformed hl.dispatch(movecursor 960 540). Silent no-op.
    #   2. `hl.dsp.movecursor(x, y)` — no such member; `attempt to call a nil value`.
    #   3. `pcall(hl.dispatch, "focusmonitor DP-3")` — hl.dispatch takes a DESCRIPTOR from
    #      hl.dsp.*, not a string. The Lua call returned fine (pcall saw success) and then
    #      Hyprland errored while processing the value, which pcall cannot catch because
    #      it is not a Lua throw. That is the banner that appeared at every login.
    #
    # The shape is settled by Hypora's own config, which does this and works:
    #     hl.dispatch(hl.dsp.focus({ workspace = ... }))
    #     hl.dispatch(hl.dsp.window.move({ monitor = ... }))
    #
    # So focus is almost certainly hl.dsp.focus({ monitor = NAME }). The cursor has no
    # known binding, so candidates are tried in order and the journal records which one
    # answered. All of it runs through hyprctl deliberately: a separate process cannot put
    # an error banner on the login screen, which is the property that matters after (3).
    # Once a form is confirmed on hardware this collapses to one in-process call.
    #
    #   journalctl -b -t hypora-greeter
    GENERATED.write_text(
        "-- Generated by hypora-greeter. Do not edit; it is rewritten on change.\n"
        "-- Focus and pointer follow the main display chosen in Hypora's Display\n"
        "-- Settings. Loaded by hyprland.lua in this directory.\n"
        f'local TARGET = "{name}"\n'
        "\n"
        "-- Runs a Lua expression through hyprctl, which wraps it in hl.dispatch(...).\n"
        "local function dispatch(expr)\n"
        "    hl.exec_cmd(\"hyprctl dispatch '\" .. expr .. \"' 2>&1 | logger -t hypora-greeter\")\n"
        "end\n"
        "\n"
        "hl.on(\"hyprland.start\", function()\n"
        "    dispatch('hl.dsp.focus({ monitor = \\\"' .. TARGET .. '\\\" })')\n"
        "\n"
        "    for _, m in ipairs(hl.get_monitors() or {}) do\n"
        "        if m.name == TARGET then\n"
        "            -- Logical size: a scaled monitor covers fewer logical pixels than its\n"
        "            -- mode suggests, and the cursor lives in logical space.\n"
        "            local s = m.scale or 1\n"
        "            local x = math.floor(m.x + (m.width / s) / 2)\n"
        "            local y = math.floor(m.y + (m.height / s) / 2)\n"
        "            -- No known cursor binding; try the plausible shapes and let the\n"
        "            -- journal say which exists. Harmless in a subprocess.\n"
        "            dispatch('hl.dsp.movecursor(' .. x .. ', ' .. y .. ')')\n"
        "            dispatch('hl.dsp.cursor.move(' .. x .. ', ' .. y .. ')')\n"
        "            return\n"
        "        end\n"
        "    end\n"
        "end)\n"
    )
    GENERATED.chmod(0o644)
    # An earlier version shelled out to this; remove it so a stale copy from a previous
    # install cannot be run by a hyprland.lua that no longer references it.
    if CURSOR_SH.is_file():
        CURSOR_SH.unlink()

    set_theme_primary(name)
    print(f"Login screen will open on {name}.")
    return 0


THEME_CONF = THEME_DIR / "theme.conf"
PRIMARY_RE = re.compile(r'^primary\s*=.*$', re.M)


def set_theme_primary(name):
    """Record the output in theme.conf, which is what the greeter's QML can actually read.

    Focusing a monitor is not enough and never could be: SDDM instantiates the theme once
    per screen, so the login panel is drawn on every monitor regardless of which one the
    compositor focuses. Main.qml reads this key and shows the panel only on the matching
    screen.

    theme.conf rather than theme.conf.user, because this SDDM build has no support for the
    latter — `strings` on its binaries finds no reference to it. hypora-theme preserves
    this line when it regenerates the colours.
    """
    if not THEME_CONF.is_file():
        print(f"Note: {THEME_CONF} is missing, so the login screen will show on every "
              f"monitor. Re-run install.sh to put the theme back.", file=sys.stderr)
        return
    text = THEME_CONF.read_text()
    line = "" if name is None else f'primary="{name}"'
    if PRIMARY_RE.search(text):
        text = PRIMARY_RE.sub(line, text).replace("\n\n\n", "\n\n")
    elif line:
        text = text.rstrip("\n") + "\n" + line + "\n"
    THEME_CONF.write_text(text)
    THEME_CONF.chmod(0o644)


def cmd_clear():
    need_root()
    had = GENERATED.is_file()
    if had:
        GENERATED.unlink()
    if CURSOR_SH.is_file():
        CURSOR_SH.unlink()
    set_theme_primary(None)
    print("Cleared; the login screen shows on every monitor again."
          if had else "Nothing to clear.")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd in ("-h", "--help"):
        print(__doc__, file=sys.stderr)
        return 0
    if cmd == "status":
        return cmd_status()
    if cmd == "set":
        if len(argv) < 3:
            sys.exit("Usage: hypora-greeter set <OUTPUT>")
        return cmd_set(argv[2])
    if cmd == "clear":
        return cmd_clear()
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
