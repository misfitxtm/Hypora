#!/usr/bin/env python3
"""hypora-sysinfo [INTERVAL]: print one line of JSON with RAM, CPU and GPU stats, forever.

Used by the system usage widget in the bar (config/quickshell/SysInfo.qml), which reads a
line at a time. Run it on its own to see what the widget sees:

    hypora-sysinfo 1

Everything comes from /proc and /sys, except NVIDIA cards, which need nvidia-smi.
Any reading that isn't available is reported as null rather than guessed at.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

HWMON = Path("/sys/class/hwmon")
DRM = Path("/sys/class/drm")

# CPU temp: driver name -> labels worth preferring, best first.
CPU_DRIVERS = {
    "k10temp": ("Tdie", "Tctl"),        # AMD
    "zenpower": ("Tdie", "Tctl"),       # AMD, third-party driver
    "coretemp": ("Package id 0",),      # Intel
    "cpu_thermal": (),                  # ARM SoCs
    "acpitz": (),                       # last resort
}


def read(path, default=None):
    try:
        return path.read_text().strip()
    except OSError:
        return default


def read_int(path):
    v = read(path)
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def hwmon_temp(dirpath, prefer=()):
    """Temperature in °C from a hwmon directory, preferring the given labels."""
    inputs = sorted(dirpath.glob("temp*_input"))
    if not inputs:
        return None
    by_label = {}
    for f in inputs:
        label = read(f.with_name(f.name.replace("_input", "_label")), "")
        by_label[label] = f
    for want in prefer:
        if want in by_label:
            v = read_int(by_label[want])
            return round(v / 1000, 1) if v is not None else None
    v = read_int(inputs[0])
    return round(v / 1000, 1) if v is not None else None


def find_cpu_temp():
    found = {}
    for d in HWMON.glob("hwmon*"):
        name = read(d / "name", "")
        if name in CPU_DRIVERS:
            found[name] = d
    for name in CPU_DRIVERS:                      # keep the preference order above
        if name in found:
            return hwmon_temp(found[name], CPU_DRIVERS[name])
    return None


def find_amd_gpu():
    """(busy percent, temp °C, name) for the first AMD/Intel card exposing gpu_busy_percent."""
    for busy_file in sorted(DRM.glob("card*/device/gpu_busy_percent")):
        device = busy_file.parent
        temp, name = None, None
        for hw in sorted((device / "hwmon").glob("hwmon*")):
            temp = hwmon_temp(hw, ("edge", "junction"))
            if temp is not None:
                name = read(hw / "name")
                break
        return read_int(busy_file), temp, name or "GPU"
    return None, None, None


def find_nvidia_gpu():
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu,name",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return None, None, None
    if out.returncode != 0 or not out.stdout.strip():
        return None, None, None
    parts = [p.strip() for p in out.stdout.strip().splitlines()[0].split(",")]
    try:
        return int(parts[0]), float(parts[1]), parts[2]
    except (IndexError, ValueError):
        return None, None, None


def mem():
    info = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            k, _, v = line.partition(":")
            info[k] = int(v.split()[0])          # kB
    except (OSError, ValueError, IndexError):
        return None
    total = info.get("MemTotal")
    avail = info.get("MemAvailable", info.get("MemFree"))
    if not total or avail is None:
        return None
    used = total - avail
    return {
        "pct": round(used / total * 100, 1),
        "usedGb": round(used / 1048576, 1),
        "totalGb": round(total / 1048576, 1),
    }


def cpu_times():
    """(busy, total) jiffies from the aggregate cpu line."""
    try:
        parts = Path("/proc/stat").read_text().split("\n", 1)[0].split()[1:]
    except (OSError, IndexError):
        return None
    try:
        nums = [int(p) for p in parts]
    except ValueError:
        return None
    idle = nums[3] + (nums[4] if len(nums) > 4 else 0)   # idle + iowait
    return sum(nums) - idle, sum(nums)


def main():
    try:
        interval = max(0.5, float(sys.argv[1])) if len(sys.argv) > 1 else 2.0
    except ValueError:
        interval = 2.0

    has_nvidia = False
    busy, _, _ = find_amd_gpu()
    if busy is None:
        has_nvidia = find_nvidia_gpu()[0] is not None

    prev = cpu_times()
    while True:
        time.sleep(interval)
        cur = cpu_times()
        cpu_pct = None
        if prev and cur and cur[1] > prev[1]:
            cpu_pct = round((cur[0] - prev[0]) / (cur[1] - prev[1]) * 100, 1)
        prev = cur or prev

        gpu_pct, gpu_temp, gpu_name = find_nvidia_gpu() if has_nvidia else find_amd_gpu()

        print(json.dumps({
            "ram": mem(),
            "cpu": {"pct": cpu_pct, "temp": find_cpu_temp()},
            "gpu": None if gpu_pct is None and gpu_temp is None
                   else {"pct": gpu_pct, "temp": gpu_temp, "name": gpu_name},
        }), flush=True)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        os._exit(0)
