// Hypora fastfetch config. Shows only what's worth knowing at a glance.
// The OS line says "Hypora Linux" with the running kernel; the theme line reads
// whichever Hypora theme is active. Key colors follow the terminal palette, so
// everything recolors when you switch themes.
// Icons need a Nerd Font (Hypora installs JetBrainsMono Nerd Font).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/hypora.txt",
        "color": { "1": "blue", "2": "cyan" },
        "padding": { "top": 1, "right": 3 }
    },

    "display": {
        "separator": "  ",
        "color": { "keys": "blue" },
        "key": { "type": "both", "width": 9 },
        "size": { "ndigits": 1, "binaryPrefix": "jedec" }
    },

    "modules": [
        "break",
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "custom", "format": "───────────────────────────────", "outputColor": "8" },

        { "type": "os",       "key": "OS",    "format": "Hypora Linux {arch}  ({kernel-release})" },
        { "type": "host",     "key": "Host" },
        { "type": "cpu",      "key": "CPU" },
        { "type": "gpu",      "key": "GPU" },
        { "type": "memory",   "key": "RAM" },
        { "type": "wm",       "key": "WM" },
        { "type": "terminal", "key": "Term" },
        {
            "type": "command",
            "key": "Theme",
            "text": "cat \"${XDG_CONFIG_HOME:-$HOME/.config}/hypora/current/name\" 2>/dev/null || echo unknown"
        },

        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
