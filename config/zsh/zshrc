# Hypora zsh config: Oh My Zsh with completion, autosuggestions and syntax highlighting.
# Put your own additions in ~/.zshrc.local. It is sourced at the end and never replaced
# by the installer.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Oh My Zsh is installed at a pinned commit (see install.sh). Its own updater would pull
# the latest master and undo that pin, and this code runs in every interactive shell.
# Update it on purpose: change the commit in install.sh and re-run it, or run `omz update`
# after reading what changed.
zstyle ':omz:update' mode disabled
DISABLE_AUTO_UPDATE=true

# Fedora ships the suggestion and highlighting plugins, so they are sourced below
# instead of being cloned into Oh My Zsh.
plugins=(git sudo dnf systemd extract colored-man-pages command-not-found)

[ -r "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ---------- history ----------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt extended_history inc_append_history

# ---------- completion ----------
setopt auto_cd auto_pushd pushd_ignore_dups no_beep interactive_comments
zstyle ':completion:*' menu select                       # arrow keys through matches
zstyle ':completion:*' matcher-list 'm:{a-zA-Z-_}={A-Za-z_-}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"  # colored like ls
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{blue}%B%d%b%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"

# ---------- suggestions and highlighting (Fedora packages) ----------
for f in /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
         /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh; do
    [ -r "$f" ] && { source "$f"; break; }
done
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# Highlighting must be sourced last of the two
for f in /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
         /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
    [ -r "$f" ] && { source "$f"; break; }
done

# ---------- keys ----------
bindkey '^[[A' history-substring-search-up 2>/dev/null || bindkey '^[[A' up-line-or-search
bindkey '^[[B' history-substring-search-down 2>/dev/null || bindkey '^[[B' down-line-or-search
bindkey '^[[1;5C' forward-word      # ctrl + right
bindkey '^[[1;5D' backward-word     # ctrl + left
bindkey '^[[3~' delete-char
bindkey '^ ' autosuggest-accept     # ctrl + space takes the whole suggestion

# ---------- environment ----------
export EDITOR=nvim
export VISUAL=nvim
# ~/.local/bin goes LAST, so a file placed there cannot shadow system commands such as sudo
path=("${path[@]:#$HOME/.local/bin}" "$HOME/.local/bin")
export PATH

# ---------- listings ----------
# eza replaces ls when installed. Its colours come from the active theme through
# ~/.config/hypora/current/eza-colors.sh (regenerated by hypora-theme). The coreutils
# aliases stay if eza is missing, so `ls` never becomes "command not found".
if command -v eza >/dev/null; then
    [ -r "$HOME/.config/hypora/current/eza-colors.sh" ] \
        && source "$HOME/.config/hypora/current/eza-colors.sh"
    # --group-directories-first is Hypora's preference. The long form shows Permissions,
    # Size, User, Date Modified and Name.
    #
    # --icons=auto, not --icons: icons are only printed to a real terminal, so piping `ls`
    # into another command does not add icon characters. The glyphs come from the Nerd Font;
    # with another font they show as boxes. EZA_ICON_SPACING=2 helps if they touch the name.
    alias ls='eza --icons=auto --group-directories-first'
    alias ll='eza -lh --icons=auto --group-directories-first'
    alias la='eza -lah --icons=auto --group-directories-first'
    alias lt='eza --tree --level=2 --icons=auto --group-directories-first'
    # The real ls is still one backslash away: \ls
else
    alias ls='ls --color=auto'
    alias ll='ls -lh --group-directories-first'
    alias la='ls -lAh --group-directories-first'
fi

# ---------- aliases ----------
alias vi=nvim
alias vim=nvim
alias grep='grep --color=auto'
alias ff=fastfetch
alias theme=hypora-theme

# Greeting, but only in a real interactive terminal
if [[ -o interactive ]] && [[ -z "$HYPORA_NO_FETCH" ]] && command -v fastfetch >/dev/null; then
    fastfetch
fi

[ -r "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
