# Environment for apps started through uwsm (the Hypora session). Read by uwsm at login.
export QT_QPA_PLATFORMTHEME=qt6ct:qt5ct

# Java/Swing apps (Ghidra, jd-gui, VisualVM, ...) ignore GTK/Qt theming entirely unless
# told to use the GTK look and feel, which then follows the active GTK theme/colours like
# any other GTK app. Apps that pin their own look and feel in code (Ghidra's FlatLaf-based
# theme manager does) override this and need theming by hand in their own settings.
export _JAVA_OPTIONS="-Dswing.defaultlaf=com.sun.java.swing.plaf.gtk.GTKLookAndFeel"

# Point ssh at gnome-keyring's agent (started in hyprland.lua). The daemon prints this for
# eval on startup, which is no use to processes that began before it; the path is fixed, so
# setting it here means everything in the session agrees on one agent socket.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/keyring/ssh"
