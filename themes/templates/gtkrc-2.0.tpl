# Generated by hypora-theme ({{ name }}). Linked as ~/.gtkrc-2.0 for GTK 2 apps (HexChat, ...),
# which ignore adw-gtk3 and gtk.css.
gtk-icon-theme-name = "{{ icon_theme }}"
gtk-font-name = "Liberation Sans 11"

style "hypora" {
    bg[NORMAL]        = "{{ surface }}"
    bg[PRELIGHT]      = "{{ selection }}"
    bg[ACTIVE]        = "{{ muted }}"
    bg[SELECTED]      = "{{ accent }}"
    bg[INSENSITIVE]   = "{{ surface }}"
    fg[NORMAL]        = "{{ foreground }}"
    fg[PRELIGHT]      = "{{ foreground }}"
    fg[ACTIVE]        = "{{ foreground }}"
    fg[SELECTED]      = "{{ background }}"
    fg[INSENSITIVE]   = "{{ dim }}"
    base[NORMAL]      = "{{ background }}"
    base[PRELIGHT]    = "{{ selection }}"
    base[ACTIVE]      = "{{ selection }}"
    base[SELECTED]    = "{{ accent }}"
    base[INSENSITIVE] = "{{ surface }}"
    text[NORMAL]      = "{{ foreground }}"
    text[PRELIGHT]    = "{{ foreground }}"
    text[ACTIVE]      = "{{ foreground }}"
    text[SELECTED]    = "{{ background }}"
    text[INSENSITIVE] = "{{ dim }}"
}
class "GtkWidget" style "hypora"
