# Generated by hypora-theme from themes/{{ name }}/colors.toml. Do not edit: change the
# palette (or themes/templates/plymouth.plymouth.tpl) and run hypora-theme again.
#
# The boot screen, including the disk passphrase prompt. Installed to
# /usr/share/plymouth/themes/hypora/hypora.plymouth and copied into the initramfs by
# dracut, so changes only show after `sudo dracut -f`.
#
# This uses the two-step module that Fedora's own themes use. It takes the colours from
# this file; everything else on screen is a PNG drawn by hypora-plymouth in the same
# palette. The prompt text is always white, so light palettes do not suit it.
#
# Be careful with comments in this file. Plymouth's tools find their settings with an
# unanchored grep, so a comment that contains a setting name followed by an equals sign
# is read as a second value. The tools then fail and the boot screen silently falls back
# to text. Avoid writing those names with an equals sign in a comment.
#
# The font named here is copied into the initramfs automatically (via fc-match).
[Plymouth Theme]
Name=Hypora
Description=Hypora boot screen, in the {{ name }} palette
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/hypora
Font={{ font }} 12
TitleFont={{ font }} 22

BackgroundStartColor=0x{{ background_hex }}
BackgroundEndColor=0x{{ background_hex }}
ProgressBarBackgroundColor=0x{{ surface_hex }}
ProgressBarForegroundColor=0x{{ accent_hex }}
ProgressBarWidth=320
ProgressBarHeight=4
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.75

DialogHorizontalAlignment=.5
DialogVerticalAlignment=.45
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.75
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.92

Transition=none
TransitionDuration=0.0
MessageBelowAnimation=true
# Without this the firmware's own logo stays behind the dialog and the palette background
# never shows. Fedora's bgrt theme keeps it on purpose; Hypora does not.
DialogClearsFirmwareBackground=true

[boot-up]
UseFirmwareBackground=false
UseEndAnimation=false
UseProgressBar=true

[shutdown]
UseFirmwareBackground=false
UseEndAnimation=false
UseProgressBar=true

[reboot]
UseFirmwareBackground=false
UseEndAnimation=false
UseProgressBar=true

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
