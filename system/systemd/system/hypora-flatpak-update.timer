# Daily, an hour after dnf-automatic's 06:00 slot so the two don't fight over the network.
# Persistent=true means a machine that was asleep at 07:00 updates shortly after it wakes,
# rather than skipping the day.
[Unit]
Description=Update system Flatpak apps daily

[Timer]
OnCalendar=*-*-* 07:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
