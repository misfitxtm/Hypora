# Keeps system flatpaks (Firefox above all) current, since dnf-automatic cannot see them; run by the timer.
[Unit]
Description=Update system Flatpak apps
Documentation=man:flatpak-update(1)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/bin/flatpak

[Service]
Type=oneshot
# Stay out of the way of anything you're actually doing
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/flatpak update --system --assumeyes --noninteractive
