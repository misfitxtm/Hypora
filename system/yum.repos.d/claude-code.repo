# Claude Code (Anthropic), stable channel. For every release as it ships, use .../rpm/latest
[claude-code]
name=Claude Code
baseurl=https://downloads.claude.ai/claude-code/rpm/stable
enabled=1
gpgcheck=1
# install.sh checks the key against Anthropic's published fingerprint and saves it here
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-claude-code
